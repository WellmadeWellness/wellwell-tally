.role{display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:4px 10px;border-radius:999px;background:var(--sunk);color:var(--muted)}
.role i{width:8px;height:8px;border-radius:50%;background:var(--muted);display:inline-block}
.role.admin i{background:var(--accent)} .role.uploader i{background:var(--parcel)} .role.viewer i{background:var(--muted)} .role.local i{background:var(--warn)}
.hdr-right{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.progress{height:4px;background:var(--sunk);border-radius:2px;overflow:hidden}
.progress b{display:block;height:100%;background:var(--accent);width:0;transition:width .2s}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--muted)}
.legend span::before{content:"";display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px;background:var(--c)}
svg text{font-family:var(--sans);fill:var(--muted);font-size:11px}
.diff-pos{color:var(--ok)} .diff-neg{color:var(--bad)}
.cal{display:grid;grid-template-columns:repeat(auto-fill,minmax(38px,1fr));gap:4px}
.day{border:1px solid var(--line);border-radius:6px;padding:3px 0 4px;text-align:center;font-size:11px;font-family:var(--mono);background:var(--surface);color:var(--ink)}
.day small{display:block;font-family:var(--sans);font-size:9px;color:var(--muted);line-height:1.1}
.day.today{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.day.future{opacity:.45}
.day.gap{background:var(--warn-soft)}
button.day{font:inherit;font-family:var(--mono);font-size:11px;cursor:pointer;width:100%}
button.day:hover{border-color:var(--muted)}
button.day.sel{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
button.day.sel small{color:var(--accent-ink)}
button.day.sel .dots i{box-shadow:0 0 0 1.5px var(--accent-ink)}
.dash{display:flex;flex-direction:column;gap:18px;padding:16px}
.dash h2{font-size:15px}
.fresh{font-size:12px;color:var(--muted)}
.cmp{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
@media (max-width:820px){.cmp{grid-template-columns:repeat(2,minmax(0,1fr))}}
.cmp div{background:var(--sunk);border-radius:8px;padding:10px 12px;min-width:0}
.cmp b{display:block;font-family:var(--mono);font-size:16px;font-weight:500;font-variant-numeric:tabular-nums}
.cmp .k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.up{color:var(--ok)} .down{color:var(--bad)}
.dgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
@media (max-width:820px){.dgrid{grid-template-columns:1fr}}
.dgrid>div{min-width:0}
.prog{display:flex;flex-direction:column;gap:10px}
.prow{display:grid;grid-template-columns:90px minmax(0,1fr) auto;gap:10px;align-items:center;font-size:13px}
.ptrack{position:relative;height:12px;background:var(--sunk);border-radius:6px;overflow:hidden}
.ptrack b{position:absolute;inset:0 auto 0 0;background:var(--c);border-radius:6px}
.ptrack i{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--ink);opacity:.55}
.alerts{margin:0;padding-left:18px;font-size:13px}
.alerts li{margin-bottom:4px}
.tform{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px}
.tform input{width:130px}
.daybar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--accent-soft);border-radius:8px;padding:8px 12px;font-size:13px}
.dots{display:flex;justify-content:center;gap:2px;height:6px;margin-top:3px}
.dots i{width:6px;height:6px;border-radius:50%;background:var(--c)}
.mstrip{display:flex;flex-direction:column;gap:10px;padding:14px 16px}
.mstrip h2{font-size:16px}
.locked #controls,.locked #tiles,.locked #monthStrip,.locked #mainPanel,.locked #filesPanel,.locked .note.rules{display:none!important}
.auth{display:flex;flex-direction:column;gap:12px;padding:20px;max-width:440px}
.auth h2{font-size:17px}
.auth input[type=email],.auth input[type=password]{width:100%;padding:8px 10px}
.auth .row{display:flex;gap:8px;flex-wrap:wrap}
.auth .err{color:var(--bad);font-size:13px;min-height:1em}
.frow{cursor:pointer}
.frow:hover td{background:var(--sunk)}
.frow.open td{background:var(--accent-soft)}
.frow:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.caret{display:inline-block;width:1em;color:var(--muted)}
.fdetail>td{background:var(--surface);padding:0}
.fbox{display:flex;flex-direction:column;gap:10px;padding:12px 16px 16px 34px;border-left:3px solid var(--accent)}
.fbox table{font-size:12px}
.daylist{max-height:520px;overflow:auto;border-top:1px solid var(--line);padding-top:8px}
.daylist .scroll{overflow:visible}
.langsw{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--surface)}
.langsw button{border:none;border-radius:0;padding:4px 11px;font-size:12px;background:transparent;color:var(--muted)}
.langsw button.on{background:var(--ink);color:var(--bg);font-weight:600}
.ko .en-only{display:none}
.lock{font-size:12px;color:var(--muted);background:var(--sunk);padding:6px 10px;border-radius:7px}
</style>

<div class="wrap">
  <header>
    <h1>Wellwell Monthly Tally<small>Retail · 택배 · 기타 – upload order files, get the month</small></h1>
    <div class="hdr-right">
      <div class="langsw no-tr" role="group" aria-label="Language / 언어"><button type="button" data-lang="ko">한국어</button><button type="button" data-lang="en">English</button></div>
      <span class="role local" id="role"><i></i><span>Starting…</span></span>
      <button class="ghost" id="signOut" hidden>Sign out</button>
      <span class="basis" title="All values use one basis: units × factory price (제조원가) including VAT. This is what Wellwell is paid on every channel.">Basis: factory price (제조원가) incl. VAT</span>
    </div>
  </header>

  <div class="panel" id="authPanel" hidden></div>
  <label class="drop" id="drop" for="fileInput">
    <p><b>Drop files here</b> or choose them: B마트, 쿠팡 and 컬리 orders (Retail), daily 발주 files (택배), 슈퍼키친, 웰스토리 and N배송 files (기타), and the month-end 정산 file for the Compare tab. Files are read in this browser – customer names, phones and addresses are never kept or shared.</p>
    <span class="btn primary" role="button" id="chooseBtn">Choose files</span>
    <input id="fileInput" type="file" accept=".xlsx,.xls,.xlsm" multiple hidden>
  </label>
  <div id="busy" hidden><div class="busy" id="busyText"></div><div class="progress"><b id="busyBar"></b></div></div>

  <div class="bar" id="controls">
    <label for="month">Month <select id="month"></select></label>
    <label><input type="checkbox" id="thirdParty"> Include non-Wellwell Coupang suppliers</label>
    <span class="spacer"></span>
    <button id="filesBtn" type="button" hidden aria-controls="filesPanel">Uploaded files <span class="pill" id="filesCount">0</span></button>
    <button id="exportBtn" class="primary" disabled title="All uploaded data for the selected month in one Excel file">Download month report</button>
  </div>

  <div class="panel" id="monthStrip" hidden></div>
  <div class="tiles" id="tiles"></div>

  <div class="panel" id="mainPanel">
    <div class="tabs" role="tablist" id="tabs"></div>
    <div id="view"></div>
  </div>
  <details class="panel" id="filesPanel" hidden>
    <summary class="section" style="cursor:pointer"><span class="bar" style="display:inline-flex"><h2 id="filesTitle">Files</h2></span></summary>
    <div class="bar" style="padding:0 16px 8px"><span class="muted small" id="filesHint"></span><span class="spacer"></span><button class="ghost" id="clearAll">Remove all files</button></div>
    <div id="filesScope"></div>
    <div class="scroll"><table id="filesTable" style="min-width:620px"></table></div>
  </details>
  <p class="note rules">Category rules: Retail = B마트, 쿠팡, 마켓컬리 orders. 택배 = every line in the daily 발주 files, including B2B, 벌크 and 오프라인 customers and samples, CS and staff purchases (marked by type). 기타 = 슈퍼키친, 웰스토리, N배송 and other separate 기타 files. Free gifts (사은품) are valued at the cost of the same product.</p>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>/*CORE*/</script>
<script>
const BASE_PRICES = /*PRICES*/;
const local = {
  get(k, d){ try{ const v = localStorage.getItem('wwtally:'+k); return v ? JSON.parse(v) : d; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem('wwtally:'+k, JSON.stringify(v)); }catch(e){} }
};
const state = {
  mode: 'local', role: 'local', me: null,
  tab: local.get('tab','dashboard'), targets: {}, month: null, thirdParty: false,
  // local mode
  localFiles: [], localSettlements: {},
  // shared mode
  meta: new Map(), chunks: new Map(), loadedMonths: new Set(), monthSubs: new Map(), settlements: {},
  priceOverrides: local.get('prices', {}), channelTypes: local.get('channels', {}),
  lines: [], names: {}, pendingRemove: null
};
let db = null, user = null, downloads = null;
// Browser database for the saved-copy (local) mode, so uploads survive closing the page.
const idb = {
  open(){ return new Promise((res, rej) => { try{ const r = indexedDB.open('wellwell-tally', 1); r.onupgradeneeded = () => r.result.createObjectStore('kv'); r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); }catch(e){ rej(e); } }); },
  async get(k){ try{ const d = await idb.open(); return await new Promise(res => { const q = d.transaction('kv').objectStore('kv').get(k); q.onsuccess = () => res(q.result); q.onerror = () => res(undefined); }); }catch(e){ return undefined; } },
  async set(k, v){ try{ const d = await idb.open(); await new Promise((res, rej) => { const t = d.transaction('kv', 'readwrite'); t.objectStore('kv').put(v, k); t.oncomplete = res; t.onerror = () => rej(t.error); }); return true; }catch(e){ return false; } }
};
let localSaveOk = null;
async function saveLocal(){
  if (state.mode !== 'local') return;
  const ok = await idb.set('files', state.localFiles) && await idb.set('settlements', state.localSettlements);
  localSaveOk = ok; setRole('local', true);
  if (!ok) toast('This browser would not save the files – they will be gone when the page closes');
}
async function loadLocal(){
  const f = await idb.get('files'); const st = await idb.get('settlements');
  if (Array.isArray(f)) state.localFiles = f; if (st && typeof st === 'object') state.localSettlements = st;
  localSaveOk = f !== undefined ? true : localSaveOk;
}
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const won = v => '₩' + Math.round(v || 0).toLocaleString('ko-KR');
const n0 = v => Math.round(v || 0).toLocaleString('ko-KR');
const short = v => { v = v || 0; const s = v < 0 ? '−' : ''; const a = Math.abs(v); if (a >= 1e8) return s+'₩' + (a/1e8).toFixed(2) + '억'; if (a >= 1e4) return s+'₩' + n0(a/1e4) + '만'; return s+won(a); };
const GROUPS = [['Retail','리테일','retail'],['Parcel','택배','parcel'],['Other','기타','other']];
const canWrite = () => state.mode === 'local' || state.role === 'admin' || state.role === 'uploader';
const canAdmin = () => state.mode === 'local' || state.role === 'admin';
function prices(){ const p = Object.assign({}, BASE_PRICES); for (const [k,v] of Object.entries(state.priceOverrides)) p[k] = [v, state.mode==='shared' ? 'Set by an editor' : 'Entered here']; return p; }
function toast(msg){ const t = document.createElement('div'); t.className='toast'; t.setAttribute('role','status'); t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(), 3000); }
function busy(text, frac){ $('#busy').hidden = text == null; if (text != null){ $('#busyText').textContent = text; $('#busyBar').style.width = Math.round((frac||0)*100) + '%'; } }
const sleep = ms => new Promise(r => setTimeout(r, ms));
async function retry(fn){ try{ return await fn(); }catch(e){ if (e && e.code === 'unavailable'){ await sleep(400 + Math.random()*600); return await fn(); } throw e; } }

// ---------- compact storage of lines (no personal data is ever in a line) ----------
const PACK = {cat:'c',channel:'ch',how:'h',date:'d',orderDate:'od',product:'p',qty:'q',boxes:'b',ref:'r',center:'ce',supplier:'s',thirdParty:'t',key:'k',sheet:'sh',storage:'st',expiry:'ex',market:'m'};
const UNPACK = Object.fromEntries(Object.entries(PACK).map(([a,b])=>[b,a]));
const pack = l => { const o = {}; for (const [a,b] of Object.entries(PACK)) if (l[a] !== undefined && l[a] !== null && l[a] !== '') o[b] = l[a]; return o; };
const unpack = (o, fileName) => { const l = { file: fileName }; for (const [b,v] of Object.entries(o)) l[UNPACK[b]||b] = v; return l; };
// Lines are stored as one JSON text per chunk (keeps Firebase from indexing every field).
const chunkLines = c => c.json ? JSON.parse(c.json) : (c.lines || []);
const monthOf = d => d ? d.slice(0,7) : 'unknown';
const pad2 = n => String(n).padStart(2,'0');
const NOW = new Date(); const TODAY = `${NOW.getFullYear()}-${pad2(NOW.getMonth()+1)}-${pad2(NOW.getDate())}`; const THIS_MONTH = TODAY.slice(0,7);
const monthLabel = m => { if (!m || m === 'all') return (typeof isKo === 'function' && isKo()) ? '전체 기간' : 'All months'; const [y,mo] = m.split('-'); if (typeof isKo === 'function' && isKo()) return `${+y}년 ${+mo}월`; return new Date(+y, +mo-1, 1).toLocaleDateString('en-US',{ month:'long', year:'numeric' }); };
const locale = () => (typeof isKo === 'function' && isKo()) ? 'ko-KR' : 'en-US';

// ---------- start-up: shared mode when the page runs inside Claude with shared data ----------
async function init(){
  render();
  if (window.FIREBASE_CONFIG && window.firebase && !/YOUR_/.test(JSON.stringify(window.FIREBASE_CONFIG))) return initFirebase();
  if (!(window.claude && window.claude.use)){ await loadLocal(); setRole('local'); if (window.FIREBASE_CONFIG) toast('Firebase is not set up yet – working in this browser only'); return; }
  try{ downloads = await window.claude.use('downloads'); }catch(e){ downloads = null; }
  try{ db = await window.claude.use('db'); user = await window.claude.use('user'); }catch(e){ db = null; }
  if (!db){ await loadLocal(); setRole('local'); return; }
  const me = user ? await user.me() : { id: null, canEdit: false };
  const w = user ? await user.can('data.write') : null;
  startShared(me.id, null, me.canEdit ? 'admin' : (w === false ? 'viewer' : 'uploader'));
}
function startShared(meId, meEmail, role){
  state.mode = 'shared'; state.me = meId; state.meEmail = meEmail;
  setRole(role);
  state.priceOverrides = {}; state.channelTypes = {};
  db.doc('config/prices').onSnapshot(s => { state.priceOverrides = (s.exists && s.data().items) || {}; recompute(); }, dbErr);
  db.doc('config/targets').onSnapshot(s => { state.targets = (s.exists && s.data().items) || {}; render(); }, dbErr);
  db.doc('config/channels').onSnapshot(s => { state.channelTypes = (s.exists && s.data().types) || {}; recompute(); }, dbErr);
  db.collection('settlements').onSnapshot(s => { state.settlements = {}; s.docs.forEach(d => state.settlements[d.id] = d.data()); recompute(); }, dbErr);
  db.collection('files').onSnapshot(s => {
    state.meta = new Map(s.docs.map(d => [d.id, Object.assign({ id: d.id }, d.data())]));
    const months = orderMonths();
    if (!state.month || (state.month !== 'all' && !allMonths().includes(state.month))) state.month = THIS_MONTH;
    ensureMonths(); resolveNames(); recompute();
  }, dbErr);
}
function dbErr(e){ if (e && e.code === 'revoked'){ setRole('viewer'); } else if (e && e.code === 'permission-denied') toast('Your account does not have access to this data. Ask an admin.'); else if (e) toast('Shared data problem: ' + (e.code || 'error')); }
function setRole(r, quiet){
  state.role = r; if (r === 'local') state.mode = 'local';
  const txt = { local: localSaveOk === false ? 'Not saved – this browser blocks storage' : 'Saved in this browser only – not shared', admin: 'Editor · saved for the team', uploader: 'Contributor · saved for the team', viewer: 'View only' }[r];
  if (quiet){ $('#role').lastElementChild.textContent = txt; return; }
  $('#role').className = 'role ' + r; $('#role').lastElementChild.textContent = txt;
  $('#drop').style.display = canWrite() ? '' : 'none';
  if (r === 'local'){ state.month = state.month || THIS_MONTH; recompute(); }
}
async function resolveNames(){
  if (!user) return; const ids = [...new Set([...state.meta.values()].map(m => m.uploadedBy).filter(Boolean))];
  if (!ids.length) return; try{ const ps = await user.profiles(ids); for (const id of ids) state.names[id] = (ps[id] && ps[id].name) || 'a team member'; renderFiles(); }catch(e){}
}
function allMonths(){
  const st = Object.values(settlementsAll()).map(x => x.month);
  return [...new Set(orderMonths().concat(st, [THIS_MONTH]))].sort();
}
function orderMonths(){
  if (state.mode === 'local') return [...new Set(state.localFiles.flatMap(f => f.lines.map(l => monthOf(f.shipOverride && l.cat==='Parcel' ? f.shipOverride : l.date))))].sort();
  return [...new Set([...state.meta.values()].flatMap(m => m.months || []))].sort();
}
function neededMonths(){
  const ms = orderMonths();
  if (state.month === 'all' || state.tab === 'trends') return ms.slice(-12);
  if (state.tab === 'dashboard' && state.month) return [state.month, prevMonth(state.month)];
  return state.month ? [state.month] : [];
}
function ensureMonths(){
  if (state.mode !== 'shared') return;
  const need = new Set(neededMonths());
  if (state.monthSubs.size > 24) for (const [m, un] of state.monthSubs) if (!need.has(m)){ un(); state.monthSubs.delete(m); state.chunks.delete(m); state.loadedMonths.delete(m); }
  for (const m of need){
    if (state.monthSubs.has(m)) continue;
    const unsub = db.collection('months/' + m + '/chunks').onSnapshot(s => {
      const mp = new Map(); s.docs.forEach(d => mp.set(d.id, d.data())); state.chunks.set(m, mp); state.loadedMonths.add(m); recompute();
    }, dbErr);
    state.monthSubs.set(m, unsub);
  }
}

// ---------- assemble files from local memory or shared chunks ----------
function currentFiles(){
  if (state.mode === 'local') return state.localFiles;
  const byFile = new Map();
  for (const [, mp] of state.chunks) for (const [, c] of mp){
    const meta = state.meta.get(c.fileId); if (!meta) continue;          // only complete uploads count
    if (!byFile.has(c.fileId)) byFile.set(c.fileId, { id: c.fileId, fileName: meta.fileName, lines: [], shipOverride: meta.shipOverride || null });
    const f = byFile.get(c.fileId); for (const o of chunkLines(c)) f.lines.push(unpack(o, meta.fileName));
  }
  return [...byFile.values()].sort((a,b) => (state.meta.get(a.id).uploadedAt||'').localeCompare(state.meta.get(b.id).uploadedAt||''));
}
function recompute(){
  state.lines = Tally.compute(currentFiles(), prices(), state.channelTypes, { includeThirdParty: state.thirdParty });
  const months = allMonths();
  if (!state.month || (state.month !== 'all' && !months.includes(state.month))) state.month = THIS_MONTH;
  $('#month').innerHTML = [...months].reverse().map(m => `<option value="${m}">${monthLabel(m)}${m===THIS_MONTH?' – this month':''}</option>`).join('') + '<option value="all">All months</option>';
  $('#month').value = state.month;
  render();
}

// ---------- upload ----------
async function sha(buf){ try{ const h = await crypto.subtle.digest('SHA-256', buf); return [...new Uint8Array(h)].slice(0,10).map(b=>b.toString(16).padStart(2,'0')).join(''); }catch(e){ return 'f' + buf.byteLength.toString(36) + Date.now().toString(36); } }
async function addFiles(list){
  if (!canWrite()){ toast('You can view this page but not upload. Ask the owner for Contributor access.'); return; }
  if (typeof XLSX === 'undefined'){ toast('The Excel reader did not load. Check the connection and reload.'); return; }
  const today = new Date().toISOString().slice(0,10);
  let i = 0, added = 0;
  for (const f of list){
    i++; busy(`Reading ${f.name} (${i} of ${list.length})`, (i-1)/list.length); await sleep(10);
    try{
      const buf = await f.arrayBuffer(); const id = await sha(buf);
      const known = state.mode === 'shared' ? state.meta.has(id) : state.localFiles.some(x => x.id === id);
      if (known){ toast(f.name + ' was already uploaded – skipped'); continue; }
      const res = Tally.parseWorkbook(XLSX, new Uint8Array(buf), f.name, today); res.id = id; res.addedAt = new Date().toISOString();
      if (res.settlement){ await saveSettlement(res.settlement); added++; continue; }
      if (!res.lines.length){ toast(f.name + ': ' + (res.notes[0] || 'no order lines found')); continue; }
      if (state.mode === 'local'){ state.localFiles.push(res); added++; continue; }
      busy(`Saving ${f.name} for the team (${i} of ${list.length})`, (i-0.5)/list.length);
      await saveShared(res); added++;
    }catch(e){ toast(`${f.name}: ${e.code === 'quota_exceeded' ? 'shared storage is full – remove old files first' : (e.message || e.code || 'could not be read')}`); }
  }
  busy(null);
  if (state.mode === 'local'){ recompute(); if (added) await saveLocal(); }
  if (added) toast(`${added} file${added>1?'s':''} added`);
}
async function writeChunks(id, lines){
  const byMonth = new Map(); for (const l of lines){ const m = monthOf(l.date); if (!byMonth.has(m)) byMonth.set(m, []); byMonth.get(m).push(pack(l)); }
  const paths = [];
  for (const [m, ls] of byMonth){
    for (let k = 0; k * 500 < ls.length; k++){
      const path = `months/${m}/chunks/${id}_${k}`;
      await retry(() => db.doc(path).set({ fileId: id, month: m, json: JSON.stringify(ls.slice(k*500, (k+1)*500)) }));
      paths.push(path);
    }
  }
  return { paths, months: [...byMonth.keys()] };
}
async function saveShared(res){
  const { paths, months } = await writeChunks(res.id, res.lines);
  await retry(() => db.doc('files/' + res.id).set({
    fileName: res.fileName, kinds: res.kinds, notes: res.notes, minor: res.minor || '',
    sheets: res.sheets.map(s => ({ name: s.name, kind: s.kind, date: s.date || null, lines: s.lines, units: s.units, shipFromName: !!s.shipFromName })),
    months, chunks: paths, lineCount: res.lines.length, units: res.lines.reduce((a,l)=>a+l.qty,0),
    uploadedBy: state.me || null, uploadedByEmail: state.meEmail || null, uploadedAt: new Date().toISOString(), shipOverride: null
  }));
  if (state.month !== 'all' && months.length && !months.includes(state.month)) toast(`${res.fileName} saved under ${months.map(monthLabel).join(', ')}`);
}
async function saveSettlement(st){
  const id = `${st.month}_${st.site}`;
  if (state.mode === 'local'){ state.localSettlements[id] = st; recompute(); return; }  // saved by addFiles
  if (!canAdmin()){ toast('Only an editor can upload the month-end settlement file'); return; }
  await retry(() => db.doc('settlements/' + id).set(Object.assign({}, st, { uploadedBy: state.me || null, uploadedAt: new Date().toISOString() })));
}
async function removeFile(id){
  if (state.mode === 'local'){ state.localFiles = state.localFiles.filter(f => f.id !== id); recompute(); saveLocal(); return; }
  const m = state.meta.get(id); if (!m) return;
  busy('Removing ' + m.fileName, .3);
  try{ for (const p of (m.chunks || [])) await retry(() => db.doc(p).delete()); await retry(() => db.doc('files/' + id).delete()); toast(m.fileName + ' removed'); }
  catch(e){ toast('Could not remove: ' + (e.code || e.message)); }
  busy(null);
}
async function setShipDate(id, date){
  if (state.mode === 'local'){ const f = state.localFiles.find(x => x.id === id); if (f){ f.shipOverride = date || null; recompute(); saveLocal(); } return; }
  const m = state.meta.get(id); if (!m) return;
  busy('Moving ' + m.fileName + ' to ' + date, .3);
  try{
    const lines = []; for (const p of m.chunks){ const s = await retry(() => db.doc(p).get()); if (s.exists) chunkLines(s.data()).forEach(o => lines.push(unpack(o, m.fileName))); }
    lines.forEach(l => { if (l.cat === 'Parcel') l.date = date; });
    for (const p of m.chunks) await retry(() => db.doc(p).delete());
    const { paths, months } = await writeChunks(id, lines);
    await retry(() => db.doc('files/' + id).update({ chunks: paths, months, shipOverride: date }));
    if (state.month !== 'all' && !months.includes(state.month)) { state.month = months[0]; } ensureMonths();
  }catch(e){ toast('Could not change the date: ' + (e.code || e.message)); }
  busy(null);
}
async function savePrice(key, val){
  if (!canAdmin()){ toast('Only an editor can change prices'); return; }
  const next = Object.assign({}, state.priceOverrides); if (val === null) delete next[key]; else next[key] = val;
  if (state.mode === 'local'){ state.priceOverrides = next; local.set('prices', next); recompute(); return; }
  try{ await retry(() => db.doc('config/prices').set({ items: next, updatedBy: state.me || null, updatedAt: new Date().toISOString() })); }catch(e){ toast('Could not save the price: ' + (e.code || e.message)); }
}
async function saveChannelType(ch, t){
  if (!canAdmin()){ toast('Only an editor can change channel types'); return; }
  const next = Object.assign({}, state.channelTypes, { [ch]: t });
  if (state.mode === 'local'){ state.channelTypes = next; local.set('channels', next); recompute(); return; }
  try{ await retry(() => db.doc('config/channels').set({ types: next, updatedBy: state.me || null, updatedAt: new Date().toISOString() })); }catch(e){ toast('Could not save: ' + (e.code || e.message)); }
}

// ---------- events ----------
const drop = $('#drop');
['dragenter','dragover'].forEach(e => drop.addEventListener(e, ev => { ev.preventDefault(); drop.classList.add('over'); }));
['dragleave','drop'].forEach(e => drop.addEventListener(e, ev => { ev.preventDefault(); drop.classList.remove('over'); }));
drop.addEventListener('drop', ev => addFiles([...ev.dataTransfer.files]));
$('#fileInput').addEventListener('change', ev => { addFiles([...ev.target.files]); ev.target.value=''; });
$('#clearAll').addEventListener('click', async () => {
  if (state.pendingRemove !== 'ALL'){ state.pendingRemove = 'ALL'; $('#clearAll').textContent = 'Click again to remove all'; setTimeout(()=>{ if (state.pendingRemove==='ALL'){ state.pendingRemove=null; $('#clearAll').textContent='Remove all files'; } }, 4000); return; }
  state.pendingRemove = null; $('#clearAll').textContent = 'Remove all files';
  if (state.mode === 'local'){ state.localFiles = []; state.localSettlements = {}; recompute(); saveLocal(); return; }
  for (const id of [...state.meta.keys()]) await removeFile(id);
});
$('#filesBtn').addEventListener('click', () => { const p = $('#filesPanel'); p.open = true; p.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
$('#thirdParty').addEventListener('change', ev => { state.thirdParty = ev.target.checked; recompute(); });
$('#month').addEventListener('change', ev => { state.month = ev.target.value; state.day = null; ensureMonths(); recompute(); });

// ---------- rendering ----------
const active = () => state.lines.filter(l => !l.excluded && (state.month === 'all' || l.month === state.month) && (!state.day || l.date === state.day));
const dayLabel = d => new Date(d + 'T00:00').toLocaleDateString(locale(), isKo() ? { month: 'long', day: 'numeric', weekday: 'short' } : { weekday: 'short', month: 'short', day: 'numeric' });
function pickDay(d){ state.day = (state.day === d) ? null : d; render(); }
function sum(arr, f){ return arr.reduce((a,x)=>a+(f(x)||0),0); }
function groupBy(arr, kf){ const m = new Map(); for (const x of arr){ const k = kf(x); if(!m.has(k)) m.set(k, []); m.get(k).push(x); } return m; }
function render(){ renderFiles(); renderMonthStrip(); renderTiles(); renderTabs(); renderView(); $('#exportBtn').disabled = !state.lines.length; }
function fileRows(){
  if (state.mode === 'local') return state.localFiles.map(f => ({ id: f.id, fileName: f.fileName, kinds: f.kinds, sheets: f.sheets, notes: f.notes, minor: f.minor, lines: f.lines.length, units: sum(f.lines,l=>l.qty), shipOverride: f.shipOverride, at: f.addedAt, months: [...new Set(f.lines.map(l => monthOf(f.shipOverride && l.cat==='Parcel' ? f.shipOverride : l.date)))], mine: true }));
  return [...state.meta.values()].sort((a,b)=>(b.uploadedAt||'').localeCompare(a.uploadedAt||'')).map(m => ({ id: m.id, fileName: m.fileName, kinds: m.kinds, sheets: m.sheets, notes: m.notes, minor: m.minor, lines: m.lineCount, units: m.units, shipOverride: m.shipOverride, months: m.months || [], by: m.uploadedBy, byEmail: m.uploadedByEmail, at: m.uploadedAt, mine: !m.uploadedBy || m.uploadedBy === state.me }));
}
function renderFiles(){
  const allRows = fileRows(); const p = $('#filesPanel'); p.hidden = !allRows.length || isViewer();
  $('#filesBtn').hidden = p.hidden; if (p.hidden) return;
  const m = state.month && state.month !== 'all' ? state.month : null;
  const inMonth = m ? allRows.filter(f => (f.months || []).includes(m)) : allRows;
  const scope = (m && state.filesScope !== 'all') ? 'month' : 'all';
  const rows = scope === 'month' ? inMonth : allRows;
  $('#filesCount').textContent = m ? inMonth.length : allRows.length;
  $('#filesBtn').title = m ? `${inMonth.length} files for ${monthLabel(m)} · ${allRows.length} in total` : `${allRows.length} files in total`;
  const scopeBar = m ? `<div class="bar" style="padding:0 16px 8px;gap:6px"><button type="button" data-scope="month" aria-pressed="${scope==='month'}" class="${scope==='month'?'primary':''}">${monthLabel(m)} (${inMonth.length})</button><button type="button" data-scope="all" aria-pressed="${scope==='all'}" class="${scope==='all'?'primary':''}">All files (${allRows.length})</button></div>` : '';
  const nw = rows.filter(f => (f.notes||[]).length || (f.kinds[0]==='Parcel' && f.sheets[0] && !f.sheets[0].shipFromName && !f.shipOverride)).length;
  $('#filesTitle').innerHTML = `${state.mode==='shared'?'Team files':'Saved files'} <span class="pill">${rows.length}</span>` + (nw ? `<span class="pill warn">${nw} with notes</span>` : '') + ' <span class="muted small" style="font-weight:400">– show details</span>';
  $('#filesHint').textContent = state.mode === 'shared' ? 'Saved permanently for the team. Every authorised person sees these files; removing a file removes it for everyone.' : 'Saved in this browser on this computer. Other people and other browsers do not see them – use the page in Claude to share.';
  $('#clearAll').hidden = !canAdmin();
  const body = rows.map(f => {
    const kind = (f.kinds||[])[0] || 'Unknown';
    const open = state.openFile === f.id;
    const sheets = (f.sheets||[]).map(s => esc((s.kind||'').split(' · ')[1] || s.kind) + (s.date ? ' <span class="muted">' + s.date + '</span>' : '')).join(', ');
    const canEditRow = canAdmin() || (canWrite() && f.mine);
    const shipVal = f.shipOverride || ((f.sheets||[])[0]||{}).date || '';
    const noDate = kind === 'Parcel' && f.sheets[0] && !f.sheets[0].shipFromName && !f.shipOverride;
    const when = f.at ? new Date(f.at).toLocaleString('ko-KR', { year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit' }) : '';
    const by = state.mode === 'shared' ? (f.byEmail || (f.by ? (state.names[f.by] || 'a team member') : '')) : '';
    const who = (by || when) ? `<div class="small muted">${esc(by)}${by && when ? ' · ' : ''}${when ? 'uploaded ' + esc(when) : ''}</div>` : '';
    const warn = noDate || (f.notes||[]).length ? ' <span class="pill warn">!</span>' : '';
    let row = `<tr class="frow${open ? ' open' : ''}" data-open="${esc(f.id)}" tabindex="0" role="button" aria-expanded="${open}"><td><span class="caret">${open ? '▾' : '▸'}</span> <b>${esc(f.fileName)}</b>${warn}${who}</td><td><span class="chip ${esc(kind)}">${esc(kind)}</span></td><td>${esc(shipVal || '–')}</td><td class="n">${n0(f.lines)}</td><td class="n">${n0(f.units)}</td></tr>`;
    if (open){
      // the file's contents: products and quantities (from the loaded month data)
      const FL = state.lines.filter(l => l.fileId === f.id);
      const ms = (f.months || []).filter(x => x !== state.month);
      let contents;
      if (FL.length){
        const prods = [...groupBy(FL, l => l.product).entries()].map(([p, y]) => ({ p, q: sum(y,l=>l.qty), v: sum(y,l=>l.value), ch: [...new Set(y.map(l=>l.channel))], dup: y.filter(l => (l.excluded||'').startsWith('Duplicate')).length, skip: y.filter(l => l.excluded && !l.excluded.startsWith('Duplicate')).length })).sort((a,b) => b.q - a.q);
        const showV = !isViewer() && FL.some(l => l.price);
        contents = table(`<th>Product</th><th>Channels</th><th class="n">Qty</th>${showV?'<th class="n">Value</th>':''}`,
          prods.map(r => `<tr><td>${esc(r.p)}${r.dup ? ` <span class="chip warn">${r.dup} dup</span>` : ''}${r.skip ? ` <span class="chip">not counted</span>` : ''}</td><td class="small muted">${esc(r.ch.slice(0,3).join(', '))}${r.ch.length>3?` +${r.ch.length-3}`:''}</td><td class="n">${n0(r.q)}</td>${showV?`<td class="n">${n0(r.v)}</td>`:''}</tr>`).join(''),
          `<tr class="tot"><td colspan="2">Total · ${prods.length} products</td><td class="n">${n0(sum(FL,l=>l.qty))}</td>${showV?`<td class="n">${n0(sum(FL,l=>l.value))}</td>`:''}</tr>`);
      } else contents = `<p class="note">${ms.length ? `Choose ${esc(ms.map(monthLabel).join(', '))} in the Month list to see this file's contents.` : 'Loading…'}</p>`;
      const ship = kind === 'Parcel' ? `<label class="small">Ship date ${canEditRow ? `<input type="date" value="${esc(shipVal)}" data-ship="${esc(f.id)}" aria-label="Ship date for ${esc(f.fileName)}">` : esc(shipVal)}</label>${noDate ? ' <span class="small" style="color:var(--warn)">No date in file name – check</span>' : ''}` : '';
      const rm = canEditRow ? `<button class="ghost" data-rm="${esc(f.id)}">${state.pendingRemove===f.id?'Confirm remove':'Remove'}</button>` : '';
      row += `<tr class="fdetail"><td colspan="5"><div class="fbox">
        <div class="bar"><span class="small"><span class="muted">Read as:</span> ${sheets || '–'}</span>${ship}<span class="spacer"></span>${rm}</div>
        ${(f.notes||[]).length || f.minor ? `<p class="note">${(f.notes||[]).map(esc).join('<br>')}${f.minor ? `${(f.notes||[]).length ? '<br>' : ''}${esc(f.minor)}` : ''}</p>` : ''}
        ${contents}</div></td></tr>`;
    }
    return row;
  }).join('');
  $('#filesScope').innerHTML = scopeBar;
  $('#filesScope').querySelectorAll('[data-scope]').forEach(b => b.onclick = () => { state.filesScope = b.dataset.scope; renderFiles(); });
  if (!rows.length){ $('#filesTable').innerHTML = `<tbody><tr><td class="empty">No files uploaded for ${esc(monthLabel(m))} yet.</td></tr></tbody>`; return; }
  $('#filesTable').innerHTML = `<thead><tr><th>File <span class="muted small" style="font-weight:400">– click a file to see what is inside</span></th><th>Type</th><th>Date</th><th class="n">Lines</th><th class="n">Units</th></tr></thead><tbody>${body}</tbody>`;
  $('#filesTable').querySelectorAll('[data-open]').forEach(tr => {
    const toggle = () => { state.openFile = state.openFile === tr.dataset.open ? null : tr.dataset.open; renderFiles(); };
    tr.onclick = toggle; tr.onkeydown = e => { if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(); } };
  });
  $('#filesTable').querySelectorAll('[data-rm]').forEach(b => b.onclick = e => {
    e.stopPropagation(); const id = b.dataset.rm;
    if (state.pendingRemove !== id){ state.pendingRemove = id; renderFiles(); setTimeout(()=>{ if (state.pendingRemove===id){ state.pendingRemove=null; renderFiles(); } }, 4000); return; }
    state.pendingRemove = null; state.openFile = null; removeFile(id);
  });
  $('#filesTable').querySelectorAll('[data-ship]').forEach(inp => { inp.onclick = e => e.stopPropagation(); inp.onchange = () => { if (inp.value) setShipDate(inp.dataset.ship, inp.value); }; });
}

// Products and quantities for one day (used under the calendar and on the Dashboard).
function dayProductsTable(day){
  const DL = state.lines.filter(l => !l.excluded && l.date === day);
  if (!DL.length) return `<p class="note">No order lines on this day.</p>`;
  const showVal = DL.some(l => l.price);
  let rows = '';
  for (const [gg,ko] of GROUPS){
    const x = DL.filter(l => l.group === gg); if (!x.length) continue;
    const prods = [...groupBy(x, l => l.product).entries()].map(([p, y]) => ({ p, q: sum(y,l=>l.qty), v: sum(y,l=>l.value), ch: [...new Set(y.map(l=>l.channel))] })).sort((a,b) => b.q - a.q);
    rows += `<tr class="sub"><td colspan="2"><span class="chip ${gg}">${gg}</span> ${ko} · ${prods.length} products</td><td class="n">${n0(sum(x,l=>l.qty))}</td>${showVal?`<td class="n">${n0(sum(x,l=>l.value))}</td>`:''}</tr>`;
    rows += prods.map(r => `<tr><td>${esc(r.p)}</td><td class="small muted">${esc(r.ch.slice(0,3).join(', '))}${r.ch.length>3?` +${r.ch.length-3}`:''}</td><td class="n">${n0(r.q)}</td>${showVal?`<td class="n">${n0(r.v)}</td>`:''}</tr>`).join('');
  }
  return table(`<th>Product</th><th>Channels</th><th class="n">Qty</th>${showVal?'<th class="n">Value</th>':''}`, rows,
    `<tr class="tot"><td colspan="2">Total · ${new Set(DL.map(l=>l.product)).size} products</td><td class="n">${n0(sum(DL,l=>l.qty))}</td>${showVal?`<td class="n">${n0(sum(DL,l=>l.value))}</td>`:''}</tr>`);
}
function renderMonthStrip(){
  const el = $('#monthStrip'); const m = state.month;
  if (!m || m === 'all'){ el.hidden = true; return; }
  el.hidden = false;
  const [y, mo] = m.split('-').map(Number); const days = new Date(y, mo, 0).getDate();
  const cur = m === THIS_MONTH, past = m < THIS_MONTH;
  const L = state.lines.filter(l => !l.excluded && l.month === m);
  const byDay = groupBy(L, l => l.date);
  const last = g => { const ds = L.filter(l => l.group === g).map(l => l.date).sort(); return ds.length ? ds[ds.length-1] : null; };
  const status = cur ? `Month to date · day ${NOW.getDate()} of ${days}` : (past ? 'Closed month – kept for reference' : 'Upcoming month');
  const lastTxt = GROUPS.map(([g,ko]) => { const d = last(g); return `${ko} ${d ? 'up to ' + d.slice(5).replace('-','/') : '–'}`; }).join(' · ');
  let cal = '';
  for (let d = 1; d <= days; d++){
    const iso = `${m}-${pad2(d)}`; const x = byDay.get(iso) || []; const wd = new Date(y, mo-1, d).getDay();
    const future = iso > TODAY; const hasParcel = x.some(l => l.group === 'Parcel');
    const gap = !future && !hasParcel && wd !== 0 && wd !== 6 && L.some(l => l.group === 'Parcel') && iso <= (last('Parcel') || '');
    const dots = GROUPS.filter(([g]) => x.some(l => l.group === g)).map(([g,,cls]) => `<i style="--c:var(--${cls})"></i>`).join('');
    const tip = x.length ? `${iso}: ${won(sum(x,l=>l.value))}` : (gap ? `${iso}: no 택배 file` : iso);
    const sel = state.day === iso;
    cal += `<button type="button" data-day="${iso}" aria-pressed="${sel}" class="day${iso===TODAY?' today':''}${future?' future':''}${gap?' gap':''}${sel?' sel':''}" title="${tip}${x.length?' – click to see this day':''}">${d}<small>${(isKo() ? '일월화수목금토' : 'SMTWTFS')[wd]}</small><div class="dots">${dots}</div></button>`;
  }
  if (state.day && state.day.slice(0,7) !== m) state.day = null;
  const dl = state.day ? L.filter(l => l.date === state.day) : [];
  const dayBar = state.day ? `<div class="daybar" role="status"><b>Showing ${esc(dayLabel(state.day))} only</b><span>${GROUPS.map(([g,ko]) => `${ko} ${won(sum(dl.filter(l=>l.group===g),l=>l.value))}`).join(' · ')} · ${n0(sum(dl,l=>l.qty))} units</span><span class="spacer"></span><button type="button" id="dayReport">Download this day</button><button type="button" id="wholeMonth">Show whole month</button></div><div class="daylist"><h2 style="margin:4px 0 6px">Products on ${esc(dayLabel(state.day))}</h2>${dayProductsTable(state.day)}</div>` : '';
  el.innerHTML = `<div class="mstrip"><div class="bar"><h2>${monthLabel(m)}</h2><span class="pill">${status}</span><span class="spacer"></span><span class="small muted">Latest: ${lastTxt}</span></div>
    <div class="cal" aria-label="Days of ${monthLabel(m)} – click a day to see only that day">${cal}</div>${dayBar}
    <div class="legend">${GROUPS.map(([g,ko,cls])=>`<span style="--c:var(--${cls})">${ko}</span>`).join('')}<span style="--c:var(--warn-soft)">Weekday with no 택배 file</span><span style="--c:var(--accent)">Selected day</span></div></div>`;
  el.querySelectorAll('[data-day]').forEach(b => b.onclick = () => pickDay(b.dataset.day));
  const wm = el.querySelector('#wholeMonth'); if (wm) wm.onclick = () => pickDay(state.day);
  const dr = el.querySelector('#dayReport'); if (dr) dr.onclick = () => exportReport(state.day);
}
function renderTiles(){
  const L = active();
  const loading = state.mode === 'shared' && state.month && state.month !== 'all' && !state.loadedMonths.has(state.month) && allMonths().length;
  const t = GROUPS.map(([g,ko,cls]) => { const x = L.filter(l=>l.group===g); const np = x.filter(l=>!l.price).length;
    return `<div class="tile ${cls}"><div class="k"><span class="en-only">${g} </span><span>${ko}</span></div><div class="v" title="${won(sum(x,l=>l.value))}">${loading?'…':short(sum(x,l=>l.value))}</div>
    <div class="s">${n0(sum(x,l=>l.qty))} units · ${n0(x.length)} lines${np?` · <span style="color:var(--warn)">${np} unpriced</span>`:''}</div></div>`; }).join('');
  const tot = sum(L,l=>l.value);
  $('#tiles').innerHTML = t + `<div class="tile total"><div class="k"><span class="en-only">Total </span><span>합계</span></div><div class="v" title="${won(tot)}">${loading?'…':short(tot)}</div><div class="s">${won(tot)}${state.day ? ' · ' + esc(dayLabel(state.day)) : (state.month&&state.month!=='all'?' · '+esc(state.month):'')}</div></div>`;
}
function issues(){
  const L = state.lines; const out = [];
  const dup = L.filter(l => (l.excluded||'').startsWith('Duplicate'));
  if (dup.length) out.push(['bad', `${dup.length} duplicate line${dup.length>1?'s':''} left out`, dup.slice(0,8).map(l=>`${l.file}: ${l.product} × ${l.qty} (${l.excluded})`)]);
  const np = L.filter(l => !l.excluded && !l.price);
  if (np.length) out.push(['warn', `${np.length} lines have no price, so they count as ₩0`, [canAdmin() ? 'Add prices in the Missing prices tab.' : 'An editor can add prices in the Missing prices tab.']]);
  const unid = L.filter(l => l.channel === 'Unidentified');
  if (unid.length) out.push(['warn', `${unid.length} 택배 lines with no channel`, unid.slice(0,6).map(l=>`${l.file}: ${l.product}`)]);
  const tp = L.filter(l => (l.excluded||'').startsWith('Third'));
  if (tp.length) out.push(['muted', `${tp.length} Coupang lines from other suppliers left out`, [...new Set(tp.map(l=>l.supplier))].map(s=>s+' – tick "Include non-Wellwell Coupang suppliers" to count them')]);
  const inferred = L.filter(l => l.how === 'order-number format');
  if (inferred.length) out.push(['muted', `${n0(inferred.length)} 택배 lines got their channel from the order-number format`, ['See the Rules tab for the patterns.']]);
  const gifts = L.filter(l => l.gift && l.price && !l.excluded);
  if (gifts.length) out.push(['muted', `${gifts.length} free-gift lines valued at cost`, [...new Set(gifts.map(l=>l.priceSrc))].slice(0,5)]);
  const ff = fileRows().filter(f => (f.notes||[]).length);
  if (ff.length) out.push(['muted', 'Notes from reading the files', ff.map(f=>`${f.fileName}: ${f.notes.join(' ')}`)]);
  return out;
}
function missing(){
  const m = groupBy(state.lines.filter(l=>!l.excluded && !l.price), l=>l.priceKey);
  return [...m.entries()].map(([k,v]) => ({ key:k, units: sum(v,l=>l.qty), lines: v.length, groups:[...new Set(v.map(l=>l.group))], gift: v.some(l=>l.gift) })).sort((a,b)=>b.units-a.units);
}
function settlementsAll(){ return state.mode === 'local' ? state.localSettlements : state.settlements; }
const TABS0 = [['dashboard','Dashboard'],['summary','Summary'],['dates','By date'],['channels','By channel'],['products','Products'],['compare','Compare 정산'],['trends','Trends'],['missing','Missing prices'],['checks','Checks'],['rules','Rules & prices']];
function renderTabs(){
  const TABS = TABS0.filter(([id]) => !(isViewer() && ['missing','rules'].includes(id))).concat(state.backend === 'firebase' && state.role === 'admin' ? [['team','Team']] : []);
  if (!TABS.some(([id]) => id === state.tab)) state.tab = 'dashboard';
  const mc = missing().length, ic = issues().filter(i=>i[0]!=='muted').length, sc = Object.keys(settlementsAll()).length;
  $('#tabs').innerHTML = TABS.map(([id,label]) => `<button role="tab" aria-selected="${state.tab===id}" data-tab="${id}">${label}${id==='missing'&&mc?`<span class="pill warn">${mc}</span>`:''}${id==='checks'&&ic?`<span class="pill bad">${ic}</span>`:''}${id==='compare'&&sc?`<span class="pill">${sc}</span>`:''}</button>`).join('');
  $('#tabs').querySelectorAll('[data-tab]').forEach(b => b.onclick = () => { state.tab = b.dataset.tab; local.set('tab', state.tab); ensureMonths(); renderTabs(); renderView(); });
}
function emptyState(){
  if (state.mode === 'shared' && !canWrite()) return `<div class="empty"><b>No files have been uploaded yet.</b><br>Totals appear here once a team member uploads this month's order files.</div>`;
  return `<div class="empty"><b>No files yet.</b><br>Drop this week's order files above. The tiles fill in as each file is read: B마트, 쿠팡 and 컬리 orders go to Retail, daily 발주 files to 택배, and 슈퍼키친, 웰스토리 and N배송 files to 기타.${state.mode==='shared'?'<br>Uploaded files are saved for everyone who has access to this page.':''}</div>`;
}
function table(head, rows, foot){ return `<div class="scroll"><table><thead><tr>${head}</tr></thead><tbody>${rows}${foot||''}</tbody></table></div>`; }
function monthTotals(m){ const x = state.lines.filter(l => !l.excluded && l.month === m); const o = { Retail:0, Parcel:0, Other:0 }; x.forEach(l => o[l.group] += l.value); o.total = o.Retail + o.Parcel + o.Other; return o; }
function renderView(){
  const v = $('#view'); const L = active();
  if (state.tab === 'dashboard'){ v.innerHTML = renderDashboard(); wireDashboard(v); return; }
  if (!state.lines.length && !['rules','compare','trends','team'].includes(state.tab)){ v.innerHTML = emptyState(); return; }
  if (state.tab === 'summary'){
    const months = [...groupBy(L, l=>l.month).keys()].sort();
    let rows = months.map(m => { const x = L.filter(l=>l.month===m); return `<tr class="sub"><td>${m}</td>${GROUPS.map(([g])=>`<td class="n">${n0(sum(x.filter(l=>l.group===g),l=>l.value))}</td>`).join('')}<td class="n">${n0(sum(x,l=>l.value))}</td><td class="n">${n0(sum(x,l=>l.qty))}</td></tr>`; }).join('');
    const foot = `<tr class="tot"><td>Total</td>${GROUPS.map(([g])=>`<td class="n">${n0(sum(L.filter(l=>l.group===g),l=>l.value))}</td>`).join('')}<td class="n">${n0(sum(L,l=>l.value))}</td><td class="n">${n0(sum(L,l=>l.qty))}</td></tr>`;
    let html = `<div class="section"><h2>Value by month (₩, incl. VAT)</h2></div>` + table(`<th>Month</th>${GROUPS.map(([g,ko])=>`<th class="n">${g} ${ko}</th>`).join('')}<th class="n">Total</th><th class="n">Units</th>`, rows, foot);
    const tg = groupBy(L.filter(l=>l.group!=='Retail'), l=>l.group+'|'+l.type);
    if (tg.size) html += `<div class="section"><h2>택배 and 기타 by type</h2><p class="note">B2B, 벌크 and 오프라인 lines inside 택배 files stay in 택배; the type shows what they are.</p></div>` + table('<th>Group</th><th>Type</th><th class="n">Lines</th><th class="n">Units</th><th class="n">Value</th>',
      [...tg.entries()].sort().map(([k,x])=>{ const [g,t]=k.split('|'); return `<tr><td><span class="chip ${g}">${g}</span></td><td>${esc(t)}</td><td class="n">${n0(x.length)}</td><td class="n">${n0(sum(x,l=>l.qty))}</td><td class="n">${n0(sum(x,l=>l.value))}</td></tr>`; }).join(''));
    v.innerHTML = html; return;
  }
  if (state.tab === 'dates'){
    const ds = [...groupBy(L, l=>l.date||'unknown').entries()].sort(); let run = 0, runMonth = null;
    v.innerHTML = table(`<th>Date</th>${GROUPS.map(([g,ko])=>`<th class="n">${g} ${ko}</th>`).join('')}<th class="n">Units</th><th class="n">Day total</th><th class="n">Month to date</th>`,
      ds.map(([d,x]) => { const wd = d!=='unknown' ? new Date(d+'T00:00').toLocaleDateString(locale(),{weekday:'short'}) : ''; if (monthOf(d) !== runMonth){ runMonth = monthOf(d); run = 0; } run += sum(x,l=>l.value); return `<tr><td>${d} <span class="muted">${wd}</span></td>${GROUPS.map(([g])=>`<td class="n">${n0(sum(x.filter(l=>l.group===g),l=>l.value))}</td>`).join('')}<td class="n">${n0(sum(x,l=>l.qty))}</td><td class="n">${n0(sum(x,l=>l.value))}</td><td class="n">${n0(run)}</td></tr>`; }).join(''),
      `<tr class="tot"><td>Total</td>${GROUPS.map(([g])=>`<td class="n">${n0(sum(L.filter(l=>l.group===g),l=>l.value))}</td>`).join('')}<td class="n">${n0(sum(L,l=>l.qty))}</td><td class="n">${n0(sum(L,l=>l.value))}</td><td></td></tr>`);
    return;
  }
  if (state.tab === 'channels'){
    const cs = [...groupBy(L, l=>l.group+'|'+l.channel).entries()].map(([k,x])=>({g:k.split('|')[0],c:k.split('|')[1],x})).sort((a,b)=>GROUPS.findIndex(g=>g[0]===a.g)-GROUPS.findIndex(g=>g[0]===b.g) || sum(b.x,l=>l.value)-sum(a.x,l=>l.value));
    v.innerHTML = table('<th>Group</th><th>Channel / customer</th><th>Type</th><th class="n">Lines</th><th class="n">Units</th><th class="n">Value</th><th class="n">Unpriced lines</th>',
      cs.map(({g,c,x})=>`<tr><td><span class="chip ${g}">${g}</span></td><td>${esc(c)}</td><td class="muted">${esc(x[0].type)}</td><td class="n">${n0(x.length)}</td><td class="n">${n0(sum(x,l=>l.qty))}</td><td class="n">${n0(sum(x,l=>l.value))}</td><td class="n">${x.filter(l=>!l.price).length||''}</td></tr>`).join(''),
      `<tr class="tot"><td colspan="3">Total</td><td class="n">${n0(L.length)}</td><td class="n">${n0(sum(L,l=>l.qty))}</td><td class="n">${n0(sum(L,l=>l.value))}</td><td></td></tr>`);
    return;
  }
  if (state.tab === 'products'){
    const ps = [...groupBy(L, l=>l.product).entries()].map(([p,x])=>({p,x})).sort((a,b)=>sum(b.x,l=>l.value)-sum(a.x,l=>l.value));
    const pr = !isViewer();
    v.innerHTML = table(`<th>Product</th><th>Groups</th><th class="n">Units</th>${pr?'<th class="n">Unit price</th>':''}<th class="n">Value</th>${pr?'<th>Price source</th>':''}`,
      ps.map(({p,x})=>`<tr><td>${esc(p)}</td><td>${[...new Set(x.map(l=>l.group))].map(g=>`<span class="chip ${g}">${g}</span>`).join(' ')}</td><td class="n">${n0(sum(x,l=>l.qty))}</td>${pr?`<td class="n">${x[0].price?n0(x[0].price):'<span class="chip warn">none</span>'}</td>`:''}<td class="n">${n0(sum(x,l=>l.value))}</td>${pr?`<td class="small muted">${esc(x[0].priceSrc||'')}</td>`:''}</tr>`).join(''));
    return;
  }
  if (state.tab === 'compare'){ v.innerHTML = renderCompare(); return; }
  if (state.tab === 'trends'){ v.innerHTML = renderTrends(); return; }
  if (state.tab === 'missing'){
    const ms = missing();
    if (!ms.length){ v.innerHTML = '<div class="empty"><b>Every line has a price.</b></div>'; return; }
    const ed = canAdmin();
    v.innerHTML = `<div class="section"><p class="note">${ed ? 'Enter the factory price per unit, including VAT (the same basis as the July 위탁 단가). ' + (state.mode==='shared' ? 'Saved prices apply for the whole team straight away.' : 'Prices are saved in this browser.') + ' For a free gift, enter the cost of the product itself.' : '<span class="lock">Only an editor can set prices. Send this list to the person who manages prices.</span>'}</p></div>` +
      table(`<th>Product (as matched)</th><th>Groups</th><th class="n">Units</th><th class="n">Lines</th>${ed?'<th>Price incl. VAT</th>':''}`,
      ms.map((m,i)=>`<tr><td>${esc(m.key)}${m.gift?' <span class="chip warn">gift</span>':''}</td><td>${m.groups.map(g=>`<span class="chip ${g}">${g}</span>`).join(' ')}</td><td class="n">${n0(m.units)}</td><td class="n">${m.lines}</td>
      ${ed?`<td><input type="number" min="0" step="10" id="mp${i}" data-key="${esc(m.key)}" aria-label="Price for ${esc(m.key)}"> <button data-save="${i}">Save</button></td>`:''}</tr>`).join(''));
    v.querySelectorAll('[data-save]').forEach(b => b.onclick = () => { const inp = $('#mp'+b.dataset.save); const val = Number(inp.value); if (!(val>0)){ toast('Enter a price above 0'); return; } savePrice(inp.dataset.key, val); toast('Price saved'); });
    return;
  }
  if (state.tab === 'checks'){
    const is = issues();
    v.innerHTML = `<div class="section"><ul class="checks" style="padding-left:18px;margin:0">${is.map(([lvl,title,items])=>`<li><b style="color:${lvl==='bad'?'var(--bad)':lvl==='warn'?'var(--warn)':'var(--ink)'}">${esc(title)}</b>${items.length?`<ul class="small muted">${items.map(i=>`<li>${esc(i)}</li>`).join('')}</ul>`:''}</li>`).join('') || '<li>No problems found.</li>'}</ul></div>`;
    return;
  }
  if (state.tab === 'rules'){ renderRules(v); return; }
  if (state.tab === 'team'){ renderTeam(v); return; }
}
function renderCompare(){
  const sts = settlementsAll(); const byMonth = groupBy(Object.values(sts), s => s.month);
  if (!byMonth.size) return `<div class="empty"><b>No settlement file yet.</b><br>Upload the month-end 정산 file (the one with the 총 합계 and 위탁 sheets) to compare it with the tally from order files.${state.mode==='shared'&&!canAdmin()?'<br>Only an editor can upload it.':''}</div>`;
  const months = [...byMonth.keys()].sort().reverse().filter(m => state.month === 'all' || m === state.month);
  if (!months.length) return `<div class="empty">No settlement for ${esc(state.month)}. Settlements loaded: ${[...byMonth.keys()].sort().map(esc).join(', ')}.</div>`;
  let html = `<div class="section"><p class="note">The settlement is mapped onto Retail / 택배 / 기타 on the same factory-price basis as the tally. 경한글로벌 is compared at factory price; its margin above that, the packaging fee and the management adjustment are listed separately because order files do not contain them.</p></div>`;
  for (const m of months){
    const list = byMonth.get(m); const g = { Retail:0, Parcel:0, Other:0, NotInOrders:0 }; const detail = [];
    for (const st of list){ const r = Tally.settlementGroups(st, state.channelTypes); for (const k in g) g[k] += r.groups[k]; r.detail.forEach(d => detail.push(Object.assign({ site: st.site }, d))); }
    const t = monthTotals(m); const hasOrders = orderMonths().includes(m); const loaded = state.mode === 'local' || !hasOrders || state.loadedMonths.has(m);
    const row = (label, a, b) => { const d = b - a; const pct = a ? d / a : 0; return `<tr><td>${label}</td><td class="n">${n0(a)}</td><td class="n">${loaded?n0(b):'…'}</td><td class="n ${d>=0?'diff-pos':'diff-neg'}">${loaded?(d>=0?'+':'')+n0(d):''}</td><td class="n">${loaded&&a?(pct*100).toFixed(1)+'%':''}</td></tr>`; };
    html += `<div class="section"><h2>${esc(m)} · settlement ${list.map(s=>esc(s.site)).join(' + ')}</h2></div>` +
      table('<th>Group</th><th class="n">Settlement</th><th class="n">Order files (tally)</th><th class="n">Difference</th><th class="n">Tally vs settlement</th>',
        GROUPS.map(([k,ko]) => row(`<span class="chip ${k}">${k}</span> ${ko}`, g[k], t[k])).join(''),
        `<tr class="tot"><td>Total</td><td class="n">${n0(g.Retail+g.Parcel+g.Other)}</td><td class="n">${loaded?n0(t.total):'…'}</td><td class="n">${loaded?n0(t.total-(g.Retail+g.Parcel+g.Other)):''}</td><td></td></tr>`) +
      (!hasOrders ? `<div class="section"><p class="note" style="color:var(--warn)">No order files have been uploaded for ${esc(m)} yet, so the tally column is empty.</p></div>` : '') +
      `<div class="section" style="padding-top:6px"><details><summary class="small" style="cursor:pointer">Settlement lines and items not in order files (${n0(g.NotInOrders)})</summary>` +
      table('<th>Site</th><th>Item</th><th>Group</th><th class="n">Value</th><th>Note</th>', detail.map(d=>`<tr><td>${esc(d.site)}</td><td>${esc(d.label)}</td><td>${d.group==='NotInOrders'?'<span class="muted">Not in order files</span>':`<span class="chip ${d.group}">${d.group}</span>`}</td><td class="n">${n0(d.value)}</td><td class="small muted">${esc(d.note)}</td></tr>`).join('')) + `</details></div>`;
  }
  return html;
}
function renderTrends(){
  const months = allMonths().slice(-12);
  if (!months.length) return emptyState();
  const sts = settlementsAll();
  const data = months.map(m => { const t = monthTotals(m); const st = Object.values(sts).filter(s => s.month === m); let sv = null;
    if (st.length){ sv = 0; st.forEach(s => { const r = Tally.settlementGroups(s, state.channelTypes).groups; sv += r.Retail + r.Parcel + r.Other; }); }
    return { m, t, sv, loaded: state.mode === 'local' || state.loadedMonths.has(m) }; });
  const max = Math.max(1, ...data.map(d => Math.max(d.t.total, d.sv || 0)));
  const W = Math.max(360, months.length * 90), H = 230, pl = 56, pb = 28, pt = 12, bw = Math.min(46, (W - pl) / months.length * 0.55);
  const y = v => pt + (H - pt - pb) * (1 - v / max);
  const ticks = [0, .25, .5, .75, 1].map(f => max * f);
  let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img" aria-label="Monthly value by group">`;
  ticks.forEach(t => { svg += `<line x1="${pl}" x2="${W}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end">${t>=1e8?(t/1e8).toFixed(1)+'억':n0(t/1e4)+'만'}</text>`; });
  data.forEach((d, i) => {
    const cx = pl + (W - pl) / months.length * (i + .5); let base = 0;
    for (const [g,,cls] of GROUPS){ const v = d.t[g]; if (!v) continue; svg += `<rect x="${cx-bw/2}" y="${y(base+v)}" width="${bw}" height="${y(base)-y(base+v)}" fill="var(--${cls})"><title>${d.m} ${g}: ${won(v)}</title></rect>`; base += v; }
    if (d.sv !== null) svg += `<line x1="${cx-bw/2-6}" x2="${cx+bw/2+6}" y1="${y(d.sv)}" y2="${y(d.sv)}" stroke="var(--accent)" stroke-width="2.5"><title>${d.m} settlement: ${won(d.sv)}</title></line>`;
    svg += `<text x="${cx}" y="${H-8}" text-anchor="middle">${d.m.slice(2)}${d.loaded?'':' …'}</text>`;
  });
  svg += '</svg>';
  const legend = `<div class="legend">${GROUPS.map(([g,ko,cls])=>`<span style="--c:var(--${cls})">${g} ${ko}</span>`).join('')}<span style="--c:var(--accent)">Settlement (same basis)</span></div>`;
  const rows = data.map(d => `<tr><td>${d.m}</td>${GROUPS.map(([g])=>`<td class="n">${d.loaded?n0(d.t[g]):'…'}</td>`).join('')}<td class="n">${d.loaded?n0(d.t.total):'…'}</td><td class="n">${d.sv!==null?n0(d.sv):''}</td></tr>`).join('');
  return `<div class="section"><h2>Last ${months.length} month${months.length>1?'s':''}</h2>${legend}<div class="scroll">${svg}</div><p class="note">Months only partly uploaded will look low. A month marked … is still loading.</p></div>` +
    table(`<th>Month</th>${GROUPS.map(([g,ko])=>`<th class="n">${g} ${ko}</th>`).join('')}<th class="n">Tally total</th><th class="n">Settlement</th>`, rows);
}
function renderRules(v){
  const ed = canAdmin();
  const chans = [...new Set(state.lines.filter(l=>l.cat==='Parcel').map(l=>l.channel))].sort();
  const opts = t => ['Online','Non-sale','B2B'].map(o=>`<option ${o===t?'selected':''}>${o}</option>`).join('');
  let html = `<div class="section"><h2>택배 channels</h2><p class="note">Every line from a 택배 file stays in 택배; the type (Online, Non-sale, B2B) only labels it. ${state.mode==='shared'?(ed?'Changes apply for the whole team.':'<span class="lock">Only an editor can change these.</span>'):'Changes are saved in this browser.'}</p></div>`;
  html += chans.length ? table('<th>Channel</th><th>Type</th><th class="n">Lines</th>', chans.map(c=>{ const t = state.channelTypes[c] || Tally.defaultChannelType(c); return `<tr><td>${esc(c)}</td><td>${ed?`<select data-ch="${esc(c)}" aria-label="Type for ${esc(c)}">${opts(t)}</select>`:esc(t)}</td><td class="n">${n0(state.lines.filter(l=>l.channel===c).length)}</td></tr>`; }).join('')) : '<div class="empty">Load 택배 files to see their channels.</div>';
  html += `<div class="section"><h2>Order-number patterns</h2><p class="note">Used when a 택배 line does not name its channel. Learned from the July 위탁 sheet.</p></div>` +
    table('<th>Pattern</th><th>Channel</th>', Tally.ORDER_RULES.map(([re,c])=>`<tr><td style="font-family:var(--mono)">${esc(re.source)}</td><td>${esc(c)}</td></tr>`).join(''));
  const P = prices(); const keys = Object.keys(P).sort();
  html += `<div class="section"><div class="bar"><h2>Price list</h2><span class="muted small">${keys.length} products · factory price incl. VAT</span><span class="spacer"></span>
    ${ed?`<label class="btn" for="priceImport" style="font-size:13px">Import prices (.xlsx)</label><input type="file" id="priceImport" accept=".xlsx,.xls" hidden>`:''}
    <button id="priceExport" style="font-size:13px">Download price list</button>
    <label for="pq">Search <input type="text" id="pq" placeholder="product name"></label></div>
    ${ed?'<p class="note">Import: an Excel sheet with columns "Product" and "Price" (incl. VAT). Matching products get the new price; new names are added.</p>':''}</div><div id="plist"></div>`;
  v.innerHTML = html;
  v.querySelectorAll('[data-ch]').forEach(s => s.onchange = () => saveChannelType(s.dataset.ch, s.value));
  const drawP = q => { const ks = keys.filter(k=>!q || k.includes(q)).slice(0,200);
    $('#plist').innerHTML = table(`<th>Product</th><th class="n">Price</th><th>Source</th>${ed?'<th></th>':''}`, ks.map(k=>`<tr><td>${esc(k)}</td><td class="n">${n0(P[k][0])}</td><td class="small muted">${esc(P[k][1])}</td>${ed?`<td>${state.priceOverrides[k]!==undefined?`<button class="ghost" data-undo="${esc(k)}">Undo edit</button>`:''}</td>`:''}</tr>`).join(''));
    $('#plist').querySelectorAll('[data-undo]').forEach(b=>b.onclick=()=>savePrice(b.dataset.undo, null)); };
  drawP(''); $('#pq').oninput = e => drawP(e.target.value.trim());
  const imp = $('#priceImport');
  if (imp) imp.onchange = async e => {
    const f = e.target.files[0]; e.target.value=''; if (!f) return;
    try{
      const wb = XLSX.read(new Uint8Array(await f.arrayBuffer()), { type:'array' }); const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval:null });
      const next = Object.assign({}, state.priceOverrides); let n = 0;
      for (const r of rows){ const k = Tally.normName(r.Product ?? r['상품명'] ?? ''); const p = Number(r.Price ?? r['단가'] ?? r['가격']); if (k && p > 0){ next[k] = p; n++; } }
      if (!n){ toast('No rows with "Product" and "Price" found'); return; }
      if (state.mode === 'local'){ state.priceOverrides = next; local.set('prices', next); recompute(); }
      else await retry(() => db.doc('config/prices').set({ items: next, updatedBy: state.me || null, updatedAt: new Date().toISOString() }));
      toast(`${n} prices imported`);
    }catch(err){ toast('Could not import: ' + (err.code || err.message)); }
  };
  $('#priceExport').onclick = () => { const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([['Product','Price','Source']].concat(keys.map(k=>[k,P[k][0],P[k][1]]))), 'Prices'); saveWorkbook(wb, 'Wellwell_Price_List.xlsx'); };
}

// ---------- export ----------
async function saveWorkbook(wb, fname){
  if (!downloads){ try{ XLSX.writeFile(wb, fname); toast('Excel downloaded'); }catch(e){ toast((window.claude ? 'Download is not available in this view' : 'Download failed: ' + e.message)); } return; }
  const data = XLSX.write(wb, { bookType:'xlsx', type:'array' });
  try{ await downloads.save({ filename: fname, data: new Uint8Array(data) }); toast('Excel saved'); }
  catch(e){ if (e && e.code !== 'declined') toast('Download did not complete (' + (e.code||'error') + ')'); }
}
function exportReport(day){
  // Month-end report: everything uploaded for the selected month (or day), one workbook.
  // Month report = whole selected month (ignores the calendar day). Day report = one day.
  const L = state.lines.filter(l => !l.excluded && (day ? l.date === day : (state.month === 'all' || l.month === state.month)));
  const wb = XLSX.utils.book_new(); const vw = isViewer();
  const label = day || (state.month === 'all' ? 'All months' : state.month);
  const title = day ? dayLabel(day) : (state.month === 'all' ? 'All months' : monthLabel(state.month));
  const SHEET_KO = { 'By day': '일별', 'By product': '제품별', 'Settlement': '정산', 'Missing prices': '가격 없음', 'Checks': '점검', '리테일 Retail': '리테일', '택배 Parcel': '택배', '기타 Other': '기타' };
  const sheet = (rows, name, widths) => { if (isKo()){ rows = rows.map(r => r.map(c => typeof c === 'string' ? trText(c) : c)); name = SHEET_KO[name] || name; } const ws = XLSX.utils.aoa_to_sheet(rows); if (widths) ws['!cols'] = widths.map(w => ({ wch: w })); XLSX.utils.book_append_sheet(wb, ws, name); };
  // 1. Summary (총 합계 style): groups, then channels inside each group
  const dates = L.map(l => l.date).filter(Boolean).sort();
  const sumRows = [[`Wellwell – ${title}`], ['Basis: factory price (제조원가) incl. VAT, from uploaded order files'],
    [`Data from ${dates[0] || '–'} to ${dates[dates.length-1] || '–'} · created ${new Date().toLocaleString('ko-KR')}`], [],
    ['Group', 'Channel', 'Lines', 'Units', 'Value (KRW incl. VAT)']];
  for (const [g,ko] of GROUPS){
    const x = L.filter(l => l.group === g);
    sumRows.push([`${g} ${ko}`, 'Subtotal', x.length, sum(x,l=>l.qty), sum(x,l=>l.value)]);
    [...groupBy(x, l => l.channel).entries()].sort((a,b) => sum(b[1],l=>l.value) - sum(a[1],l=>l.value))
      .forEach(([c, y]) => sumRows.push(['', c, y.length, sum(y,l=>l.qty), sum(y,l=>l.value)]));
  }
  sumRows.push([], ['Total 합계', '', L.length, sum(L,l=>l.qty), sum(L,l=>l.value)]);
  const np = L.filter(l => !l.price).length;
  if (np) sumRows.push([], [`Note: ${np} lines have no price and are counted as 0.`]);
  sheet(sumRows, '총 합계', [16, 26, 10, 12, 20]);
  // 2. One sheet per group with every line (like the 위탁 / 쿠팡 / 기타 sheets)
  const head = vw ? ['Date','Channel','Type','Product','Qty','Value'] : ['Date','Channel','Type','Product','Qty','Unit price','Value','Price source','File','Reference'];
  const row = l => vw ? [l.date,l.channel,l.type,l.product,l.qty,l.value] : [l.date,l.channel,l.type,l.product,l.qty,l.price||0,l.value,l.priceSrc||'NO PRICE',l.file,l.ref||''];
  for (const [g,ko] of GROUPS){
    const x = L.filter(l => l.group === g).sort((a,b) => (a.date||'').localeCompare(b.date||'') || a.channel.localeCompare(b.channel));
    const rows = [head].concat(x.map(row));
    // No total row under the lines, so a pivot over whole columns (e.g. D:E) adds up correctly.
    // The totals are in the product summary on the right and in 총 합계.
    // Product summary to the right of the lines (like a pivot: product → total quantity), sorted by product name.
    const piv = [['Product (summary)', 'Qty']].concat([...groupBy(x, l => l.product).entries()]
      .map(([p, y]) => [p, sum(y, l => l.qty)]).sort((a, b) => a[0].localeCompare(b[0], 'ko')));
    piv.push(['Total', sum(x, l => l.qty)]);
    const w = head.length;
    for (let i = 0; i < Math.max(rows.length, piv.length); i++){
      const r = (rows[i] || []).slice(); while (r.length < w) r.push(null);
      rows[i] = r.concat([null], piv[i] || []);
    }
    sheet(rows, `${ko} ${g}`, (vw ? [11,18,10,44,8,14] : [11,18,10,44,8,10,14,30,24,18]).concat([3, 44, 10]));
  }
  // 3. By day, with running total
  let run = 0; const dayRows = [['Date','Weekday', ...GROUPS.map(([g,ko]) => `${g} ${ko}`), 'Day total', 'Running total']];
  for (const [d, x] of [...groupBy(L, l => l.date || 'unknown').entries()].sort()){
    run += sum(x,l=>l.value);
    dayRows.push([d, d !== 'unknown' ? new Date(d+'T00:00').toLocaleDateString(locale(),{weekday:'short'}) : '', ...GROUPS.map(([g]) => sum(x.filter(l=>l.group===g),l=>l.value)), sum(x,l=>l.value), run]);
  }
  sheet(dayRows, 'By day', [11,8,16,16,16,16,16]);
  // 4. By product
  const prodRows = [['Product','Groups','Units','Value']].concat([...groupBy(L, l => l.product).entries()]
    .sort((a,b) => sum(b[1],l=>l.value) - sum(a[1],l=>l.value))
    .map(([p, x]) => [p, [...new Set(x.map(l=>l.group))].join(', '), sum(x,l=>l.qty), sum(x,l=>l.value)]));
  sheet(prodRows, 'By product', [44,18,10,16]);
  // 5. Settlement comparison, missing prices and checks (not for viewers where prices show)
  const sts = Object.values(settlementsAll()).filter(s => state.month === 'all' || s.month === state.month);
  if (sts.length){
    const cr = [['Month','Site','Item','Group','Value','Note']];
    for (const s of sts) Tally.settlementGroups(s, state.channelTypes).detail.forEach(d => cr.push([s.month, s.site, d.label, d.group, d.value, d.note]));
    sheet(cr, 'Settlement', [9,8,34,12,16,40]);
  }
  if (!vw && missing().length) sheet([['Product','Units','Lines']].concat(missing().map(m=>[m.key,m.units,m.lines])), 'Missing prices', [44,10,8]);
  const ck = [['Check','Detail']]; for (const [,t,items] of issues()){ ck.push([t,'']); items.forEach(i=>ck.push(['',i])); }
  if (!vw) sheet(ck, 'Checks', [50,80]);
  saveWorkbook(wb, `Wellwell_${day ? 'Day' : 'Month'}_Report_${label.replace(/\s/g,'_')}.xlsx`);
}
$('#exportBtn').addEventListener('click', () => exportReport(null));

// ================= Firebase backend (GitHub Pages hosting) =================
// The page talks to Firebase through the same small interface it uses inside Claude:
// db.doc(path).get/set/update/delete/onSnapshot and db.collection(path).onSnapshot.
let fb = null;
function fbDb(fs){
  const wrapErr = e => ({ code: (e && e.code) || 'error', message: e && e.message });
  const docRef = path => { const r = fs.doc(path); return {
    path, id: r.id,
    get: () => r.get().catch(e => { throw wrapErr(e); }),
    set: d => r.set(d).catch(e => { throw wrapErr(e); }),
    update: d => r.update(d).catch(e => { throw wrapErr(e); }),
    delete: () => r.delete().catch(e => { throw wrapErr(e); }),
    onSnapshot: (next, err) => r.onSnapshot(next, e => err && err(wrapErr(e)))
  }; };
  const coll = path => { const c = fs.collection(path); return {
    path, doc: id => docRef(path + '/' + id),
    get: () => c.get().catch(e => { throw wrapErr(e); }),
    onSnapshot: (next, err) => c.onSnapshot(next, e => err && err(wrapErr(e)))
  }; };
  return { doc: docRef, collection: coll };
}
function authPanel(html){ const p = $('#authPanel'); p.hidden = !html; document.body.classList.toggle('locked', !!html); p.innerHTML = html || ''; $('#drop').style.display = html ? 'none' : (canWrite() ? '' : 'none'); }
async function initFirebase(){
  state.backend = 'firebase'; state.mode = 'shared';
  try{ firebase.initializeApp(window.FIREBASE_CONFIG); }catch(e){ if (!/already exists/.test(e.message)){ toast('Firebase setup error: ' + e.message); await loadLocal(); setRole('local'); return; } }
  const auth = firebase.auth(); const fs = firebase.firestore();
  fb = { auth, fs };
  $('#signOut').onclick = () => auth.signOut().then(() => location.reload());
  $('#role').lastElementChild.textContent = 'Checking sign-in…';
  auth.onAuthStateChanged(async u => {
    if (!u){ showSignIn(); return; }
    $('#signOut').hidden = false;
    const isPassword = u.providerData.some(p => p.providerId === 'password');
    if (isPassword && !u.emailVerified){ showVerify(u); return; }
    const email = (u.email || '').toLowerCase();
    let role = null;
    try{ const r = await fs.doc('roles/' + email).get(); role = r.exists ? r.data().role : null; }catch(e){ role = null; }
    if (!['admin','uploader','viewer'].includes(role)){
      authPanel(`<div class="auth"><h2>Signed in as ${esc(email)}</h2><p>This account is not on the team list yet, so it cannot see the data. Ask an admin to add <b>${esc(email)}</b> in the Team tab, then reload this page.</p><div class="row"><button id="reloadBtn">Reload</button></div></div>`);
      setRole('viewer'); $('#role').lastElementChild.textContent = 'No access yet';
      $('#reloadBtn').onclick = () => location.reload(); return;
    }
    authPanel(null);
    db = fbDb(fs); user = null;
    startShared(u.uid, email, role);
    const txt = { admin: 'Admin', uploader: 'Uploader', viewer: 'Viewer' }[role];
    $('#role').lastElementChild.textContent = `${txt} · ${email}`;
    $('#drop').style.display = canWrite() ? '' : 'none';
  });
}
function showSignIn(mode){
  setRole('viewer'); $('#role').lastElementChild.textContent = 'Not signed in'; $('#signOut').hidden = true;
  const create = mode === 'create';
  authPanel(`<form class="auth" id="authForm" novalidate>
    <h2>${create ? 'Create an account' : 'Sign in to Wellwell Monthly Tally'}</h2>
    <p class="note">Only people on the team list can see the data. ${create ? 'After creating the account, confirm your email, then ask an admin to add you.' : ''}</p>
    <button type="button" id="googleBtn">Continue with Google</button>
    <div class="muted small">or with email</div>
    <label for="authEmail">Email <input type="email" id="authEmail" autocomplete="email" required></label>
    <label for="authPass">Password <input type="password" id="authPass" autocomplete="${create?'new-password':'current-password'}" minlength="6" required></label>
    <div class="err" id="authErr" role="alert"></div>
    <div class="row"><button class="primary" type="submit">${create ? 'Create account' : 'Sign in'}</button>
    <button type="button" class="ghost" id="switchBtn">${create ? 'I already have an account' : 'Create an account'}</button>
    ${create ? '' : '<button type="button" class="ghost" id="resetBtn">Forgot password</button>'}</div></form>`);
  const err = m => { $('#authErr').textContent = m; };
  const nice = e => ({ 'auth/invalid-credential':'Wrong email or password.', 'auth/wrong-password':'Wrong email or password.', 'auth/user-not-found':'No account with that email.', 'auth/email-already-in-use':'That email already has an account – sign in instead.', 'auth/weak-password':'Use at least 6 characters.', 'auth/invalid-email':'That email address is not valid.', 'auth/popup-closed-by-user':'The Google window was closed.', 'auth/unauthorized-domain':'This web address is not allowed in Firebase yet (Authentication → Settings → Authorized domains).' }[e.code] || e.message);
  $('#googleBtn').onclick = () => fb.auth.signInWithPopup(new firebase.auth.GoogleAuthProvider()).catch(e => err(nice(e)));
  $('#switchBtn').onclick = () => showSignIn(create ? null : 'create');
  if ($('#resetBtn')) $('#resetBtn').onclick = () => { const em = $('#authEmail').value.trim(); if (!em){ err('Type your email first.'); return; } fb.auth.sendPasswordResetEmail(em).then(() => err('A reset link was sent to ' + em + '.')).catch(e => err(nice(e))); };
  $('#authForm').onsubmit = async ev => { ev.preventDefault(); err('');
    const em = $('#authEmail').value.trim(), pw = $('#authPass').value;
    try{
      if (create){ const c = await fb.auth.createUserWithEmailAndPassword(em, pw); await c.user.sendEmailVerification(); }
      else await fb.auth.signInWithEmailAndPassword(em, pw);
    }catch(e){ err(nice(e)); } };
}
function showVerify(u){
  setRole('viewer'); $('#role').lastElementChild.textContent = 'Email not confirmed';
  authPanel(`<div class="auth"><h2>Confirm your email</h2><p>We sent a link to <b>${esc(u.email)}</b>. Open it, then click Continue.</p><div class="err" id="vErr"></div>
    <div class="row"><button class="primary" id="vCont">Continue</button><button class="ghost" id="vSend">Send the link again</button></div></div>`);
  $('#vCont').onclick = async () => { await u.reload(); if (fb.auth.currentUser.emailVerified){ await fb.auth.currentUser.getIdToken(true); location.reload(); } else $('#vErr').textContent = 'Not confirmed yet.'; };
  $('#vSend').onclick = () => u.sendEmailVerification().then(() => $('#vErr').textContent = 'Sent.').catch(e => $('#vErr').textContent = e.message);
}
let teamCache = null;
function renderTeam(v){
  if (!fb){ v.innerHTML = ''; return; }
  const draw = () => {
    const rows = (teamCache || []).map(t => `<tr><td>${esc(t.id)}</td><td><select data-role="${esc(t.id)}" aria-label="Role for ${esc(t.id)}">${['admin','uploader','viewer'].map(r=>`<option ${r===t.role?'selected':''}>${r}</option>`).join('')}</select></td><td>${t.id===state.meEmail?'<span class="muted small">you</span>':`<button class="ghost" data-del="${esc(t.id)}">Remove</button>`}</td></tr>`).join('');
    v.innerHTML = `<div class="section"><h2>Team</h2><p class="note">Admins change prices, rules and the team, and upload settlements. Uploaders add and remove their own order files. Viewers only look. A person signs in with this exact email (Google or email + password).</p>
      <form class="bar" id="addForm"><label for="newEmail">Email <input type="email" id="newEmail" required placeholder="name@wellwell.co.kr"></label>
      <label for="newRole">Role <select id="newRole"><option>uploader</option><option>viewer</option><option>admin</option></select></label><button class="primary" type="submit">Add</button></form></div>` +
      (teamCache ? table('<th>Email</th><th>Role</th><th></th>', rows) : '<div class="empty">Loading…</div>');
    v.querySelector('#addForm').onsubmit = async e => { e.preventDefault(); const em = $('#newEmail').value.trim().toLowerCase(); if (!/^[^@\s/]+@[^@\s/]+\.[^@\s/]+$/.test(em)){ toast('Enter a valid email'); return; }
      try{ await fb.fs.doc('roles/' + em).set({ role: $('#newRole').value, addedBy: state.meEmail, addedAt: new Date().toISOString() }); toast(em + ' added'); }catch(err){ toast('Could not add: ' + err.code); } };
    v.querySelectorAll('[data-role]').forEach(sel => sel.onchange = () => fb.fs.doc('roles/' + sel.dataset.role).update({ role: sel.value }).then(() => toast('Role changed')).catch(e => toast('Could not change: ' + e.code)));
    v.querySelectorAll('[data-del]').forEach(b => b.onclick = () => { if (b.dataset.confirm){ fb.fs.doc('roles/' + b.dataset.del).delete().then(() => toast('Removed')).catch(e => toast('Could not remove: ' + e.code)); } else { b.dataset.confirm = 1; b.textContent = 'Confirm remove'; } });
  };
  if (!renderTeam.sub){ renderTeam.sub = fb.fs.collection('roles').onSnapshot(s => { teamCache = s.docs.map(d => ({ id: d.id, role: d.data().role })).sort((a,b)=>a.id.localeCompare(b.id)); if (state.tab === 'team') draw(); }, e => toast('Could not read the team list: ' + e.code)); }
  draw();
}

// ================= Dashboard (first tab; the main screen for viewers) =================
const isViewer = () => state.mode === 'shared' && state.role === 'viewer';
function prevMonth(m){ const [y,mo] = m.split('-').map(Number); const d = new Date(y, mo-2, 1); return `${d.getFullYear()}-${pad2(d.getMonth()+1)}`; }
function daysIn(m){ const [y,mo] = m.split('-').map(Number); return new Date(y, mo, 0).getDate(); }
function targetsFor(m){ return (state.mode === 'local' ? local.get('targets', {}) : state.targets)[m] || {}; }
async function saveTargets(m, t){
  if (!canAdmin()){ toast('Only an admin can set targets'); return; }
  if (state.mode === 'local'){ const all = local.get('targets', {}); all[m] = t; local.set('targets', all); render(); toast('Targets saved'); return; }
  const next = Object.assign({}, state.targets, { [m]: t });
  try{ await retry(() => db.doc('config/targets').set({ items: next, updatedBy: state.me || null, updatedAt: new Date().toISOString() })); toast('Targets saved'); }catch(e){ toast('Could not save targets: ' + (e.code || e.message)); }
}
function pctTxt(a, b){ if (!b) return a ? '<span class="up">new</span>' : '–'; const p = (a - b) / b * 100; return `<span class="${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '▲' : '▼'} ${Math.abs(p).toFixed(1)}%</span>`; }
function renderDashboard(){
  const m = (!state.month || state.month === 'all') ? THIS_MONTH : state.month;
  const pm = prevMonth(m), days = daysIn(m), cur = m === THIS_MONTH;
  const cut = cur ? NOW.getDate() : days;
  const all = state.lines.filter(l => !l.excluded);
  const L = all.filter(l => l.month === m);
  const P = all.filter(l => l.month === pm && +l.date.slice(8) <= cut);
  const loading = state.mode === 'shared' && (!state.loadedMonths.has(m) && orderMonths().includes(m) || (!state.loadedMonths.has(pm) && orderMonths().includes(pm)));
  const g = (arr, grp) => sum(arr.filter(l => !grp || l.group === grp), l => l.value);
  // freshness
  const lastDate = grp => { const ds = L.filter(l => l.group === grp).map(l => l.date).sort(); return ds.length ? ds[ds.length-1] : null; };
  let lastUpload = null;
  if (state.mode === 'shared') for (const mt of state.meta.values()) if (mt.uploadedAt && (!lastUpload || mt.uploadedAt > lastUpload)) lastUpload = mt.uploadedAt;
  const fresh = GROUPS.map(([gg,ko]) => `${ko} up to ${lastDate(gg) ? lastDate(gg).slice(5).replace('-','/') : '–'}`).join(' · ') + (lastUpload ? ` · last upload ${new Date(lastUpload).toLocaleString('ko-KR', { month:'numeric', day:'numeric', hour:'2-digit', minute:'2-digit' })}` : '');
  // comparison
  const span = cur ? `${monthLabel(m).split(' ')[0]} 1–${cut}` : monthLabel(m);
  const pspan = cur ? `${monthLabel(pm).split(' ')[0]} 1–${Math.min(cut, daysIn(pm))}` : monthLabel(pm);
  const cmp = GROUPS.map(([gg,ko]) => `<div><span class="k">${gg} ${ko}</span><b>${short(g(L,gg))}</b><span class="small">${pctTxt(g(L,gg), g(P,gg))} <span class="muted">vs ${short(g(P,gg))}</span></span></div>`).join('') +
    `<div><span class="k">Total 합계</span><b>${short(g(L))}</b><span class="small">${pctTxt(g(L), g(P))} <span class="muted">vs ${short(g(P))}</span></span></div>`;
  // targets
  const t = targetsFor(m); const pace = cut / days;
  const prow = ([gg,ko,cls]) => { const tv = +t[gg] || 0, a = g(L,gg); if (!tv) return `<div class="prow"><span>${ko}</span><span class="muted small">No target set</span><span></span></div>`;
    const r = a / tv; const ok = r >= pace * 0.97;
    return `<div class="prow"><span>${ko}</span><div class="ptrack" title="${won(a)} of ${won(tv)}"><b style="--c:var(--${cls});width:${Math.min(100, r*100).toFixed(1)}%"></b>${cur?`<i style="left:${(pace*100).toFixed(1)}%" title="Where the month should be today"></i>`:''}</div><span class="small"><b>${(r*100).toFixed(0)}%</b> of ${short(tv)} ${cur ? `<span class="${ok?'up':'down'}">${ok?'on pace':'behind pace'}</span>` : ''}</span></div>`; };
  const tform = canAdmin() ? `<form class="tform" id="tform"><span class="muted">Set targets for ${monthLabel(m)} (₩ incl. VAT):</span>${GROUPS.map(([gg,ko]) => `<label for="t_${gg}">${ko} <input type="number" id="t_${gg}" min="0" step="100000" value="${t[gg] || ''}"></label>`).join('')}<button type="submit">Save targets</button></form>` : '';
  // daily chart
  const byDay = groupBy(L, l => +l.date.slice(8));
  const vals = Array.from({ length: days }, (_, i) => { const x = byDay.get(i+1) || []; return GROUPS.map(([gg]) => g(x, gg)); });
  const cum = []; vals.reduce((a, v, i) => (cum[i] = a + v[0] + v[1] + v[2]), 0);
  const maxBar = Math.max(1, ...vals.map(v => v[0]+v[1]+v[2])), maxCum = Math.max(1, cum[cum.length-1] || 0);
  const W = 1000, H = 230, pl = 56, pr = 64, pt = 10, pb = 24, cw = (W - pl - pr) / days, bw = Math.max(3, cw * 0.62);
  const y1 = v => pt + (H-pt-pb) * (1 - v / maxBar), y2 = v => pt + (H-pt-pb) * (1 - v / maxCum);
  let svg = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;min-width:560px;max-width:1000px;display:block" role="img" aria-label="Daily value and month-to-date total">`;
  [0, .5, 1].forEach(f => { svg += `<line x1="${pl}" x2="${W-pr}" y1="${y1(maxBar*f)}" y2="${y1(maxBar*f)}" stroke="var(--line)"/><text x="${pl-6}" y="${y1(maxBar*f)+4}" text-anchor="end">${short(maxBar*f).replace('₩','')}</text><text x="${W-pr+6}" y="${y2(maxCum*f)+4}">${short(maxCum*f).replace('₩','')}</text>`; });
  vals.forEach((v, i) => { const x = pl + cw * i + (cw - bw) / 2; let base = 0;
    GROUPS.forEach(([gg,,cls], k) => { if (!v[k]) return; svg += `<rect x="${x}" y="${y1(base+v[k])}" width="${bw}" height="${y1(base)-y1(base+v[k])}" fill="var(--${cls})"><title>${m}-${pad2(i+1)} ${gg}: ${won(v[k])}</title></rect>`; base += v[k]; });
    if ((i+1) % 5 === 0 || i === 0) svg += `<text x="${pl + cw*i + cw/2}" y="${H-6}" text-anchor="middle">${i+1}</text>`; });
  const lastI = cur ? Math.min(cut, days) : days;
  svg += `<polyline fill="none" stroke="var(--accent)" stroke-width="2" points="${cum.slice(0, lastI).map((c,i) => `${pl + cw*i + cw/2},${y2(c)}`).join(' ')}"/>`;
  if (lastI) svg += `<circle cx="${pl + cw*(lastI-1) + cw/2}" cy="${y2(cum[lastI-1])}" r="3.5" fill="var(--accent)"><title>Month to date: ${won(cum[lastI-1])}</title></circle>`;
  svg += '</svg>';
  // top lists
  const top = (kf) => [...groupBy(L, kf).entries()].map(([k, x]) => ({ k, v: g(x), grp: x[0].group })).sort((a,b) => b.v - a.v).slice(0, 5);
  const tot = g(L) || 1;
  const topTable = (rows, label) => table(`<th>${label}</th><th class="n">Value</th><th class="n">Share</th>`, rows.map(r => `<tr><td><span class="chip ${r.grp}">${r.grp}</span> ${esc(r.k)}</td><td class="n">${n0(r.v)}</td><td class="n">${(r.v/tot*100).toFixed(1)}%</td></tr>`).join('') || '<tr><td colspan="3" class="muted">No data yet</td></tr>');
  // alerts
  const alerts = [];
  const hasParcel = L.some(l => l.group === 'Parcel');
  if (hasParcel){ const miss = []; const end = cur ? cut - 1 : days;
    for (let d = 1; d <= end; d++){ const wd = new Date(+m.slice(0,4), +m.slice(5)-1, d).getDay(); if (wd === 0 || wd === 6) continue; if (!L.some(l => l.group === 'Parcel' && +l.date.slice(8) === d)) miss.push(d); }
    if (miss.length) alerts.push(`<b>No 택배 file</b> for ${miss.length} weekday${miss.length>1?'s':''}: ${miss.map(d => `${+m.slice(5)}/${d}`).join(', ')}. Totals for those days may be missing.`); }
  else if (L.length) alerts.push('<b>No 택배 files</b> uploaded for this month yet.');
  const np = L.filter(l => !l.price).length;
  if (np) alerts.push(`<b>${np} lines have no price</b>, so the totals are lower than the real figure.${isViewer() ? '' : ' Add prices in the Missing prices tab.'}`);
  const dup = state.lines.filter(l => l.month === m && (l.excluded||'').startsWith('Duplicate')).length;
  if (dup) alerts.push(`${dup} duplicate line${dup>1?'s were':' was'} found and counted once.`);
  // Product list for one day: the selected calendar day, or the latest day with data in this month.
  const dsAll = [...new Set(L.map(l => l.date).filter(Boolean))].sort();
  const pdDay = (state.day && state.day.slice(0,7) === m) ? state.day : (dsAll.filter(d => d <= TODAY).pop() || dsAll[dsAll.length-1] || null);
  const pdIdx = dsAll.indexOf(pdDay);
  const DL = pdDay ? L.filter(l => l.date === pdDay) : [];
  const showVal = DL.some(l => l.price);
  let pdRows = '';
  for (const [gg,ko] of GROUPS){
    const x = DL.filter(l => l.group === gg); if (!x.length) continue;
    const prods = [...groupBy(x, l => l.product).entries()].map(([p, y]) => ({ p, q: sum(y,l=>l.qty), v: sum(y,l=>l.value), ch: [...new Set(y.map(l=>l.channel))] })).sort((a,b) => b.q - a.q);
    pdRows += `<tr class="sub"><td colspan="2"><span class="chip ${gg}">${gg}</span> ${ko} · ${prods.length} products</td><td class="n">${n0(sum(x,l=>l.qty))}</td>${showVal?`<td class="n">${n0(sum(x,l=>l.value))}</td>`:''}</tr>`;
    pdRows += prods.map(r => `<tr><td>${esc(r.p)}</td><td class="small muted">${esc(r.ch.slice(0,3).join(', '))}${r.ch.length>3?` +${r.ch.length-3}`:''}</td><td class="n">${n0(r.q)}</td>${showVal?`<td class="n">${n0(r.v)}</td>`:''}</tr>`).join('');
  }
  const pdNav = pdDay ? `<div class="bar"><h2>Products on ${esc(dayLabel(pdDay))}</h2><span class="pill">${state.day === pdDay ? 'selected day' : 'latest day with data'}</span><span class="spacer"></span>
      <button type="button" id="pdPrev" ${pdIdx > 0 ? '' : 'disabled'} aria-label="Previous day with data">‹ Previous</button><button type="button" id="pdNext" ${pdIdx >= 0 && pdIdx < dsAll.length-1 ? '' : 'disabled'} aria-label="Next day with data">Next ›</button></div>
      <p class="note">Click any day in the calendar above to see its products. Quantities are units; the same product from several channels is added together.</p>` : '';
  const pdHtml = (state.day && state.day === pdDay) ? `<div><div class="bar"><h2>Products on ${esc(dayLabel(pdDay))}</h2><span class="spacer"></span><button type="button" id="pdPrev" ${pdIdx > 0 ? '' : 'disabled'}>‹ Previous</button><button type="button" id="pdNext" ${pdIdx >= 0 && pdIdx < dsAll.length-1 ? '' : 'disabled'}>Next ›</button></div><p class="note">The product list for this day is shown under the calendar above.</p></div>` : pdDay ? `<div>${pdNav}${table(`<th>Product</th><th>Channels</th><th class="n">Qty</th>${showVal?'<th class="n">Value</th>':''}`, pdRows, `<tr class="tot"><td colspan="2">Total · ${new Set(DL.map(l=>l.product)).size} products</td><td class="n">${n0(sum(DL,l=>l.qty))}</td>${showVal?`<td class="n">${n0(sum(DL,l=>l.value))}</td>`:''}</tr>`)}</div>`
    : `<div><h2>Products by day</h2><p class="note">No order lines for ${monthLabel(m)} yet. Upload files and they appear here by day.</p></div>`;
  const SHOW_TARGETS = false;   // comparison with last month and monthly targets – switch on later if wanted
  return `<div class="dash">
    <div class="bar"><h2>${monthLabel(m)} overview</h2><span class="spacer"></span><span class="fresh">${loading ? 'Loading…' : 'Data: ' + fresh}</span></div>
    ${pdHtml}
    ${SHOW_TARGETS ? `<div><p class="note" style="margin-bottom:8px">${esc(span)} compared with ${esc(pspan)}</p><div class="cmp">${cmp}</div></div>` : ''}
    ${SHOW_TARGETS ? `<div class="prog"><h2>Monthly targets</h2>${GROUPS.map(prow).join('')}${cur && Object.keys(t).length ? '<p class="note">The thin line marks where the month should be today if sales were spread evenly.</p>' : ''}${tform}</div>` : ''}
    <div><h2>Daily value</h2><div class="legend" style="margin:6px 0">${GROUPS.map(([gg,ko,cls]) => `<span style="--c:var(--${cls})">${ko}</span>`).join('')}<span style="--c:var(--accent)">Month to date (right scale)</span></div><div class="scroll">${svg}</div></div>
    <div class="dgrid"><div><h2 style="margin-bottom:6px">Top 5 channels</h2>${topTable(top(l => l.channel), 'Channel')}</div><div><h2 style="margin-bottom:6px">Top 5 products</h2>${topTable(top(l => l.product), 'Product')}</div></div>
    <div><h2 style="margin-bottom:6px">Alerts</h2>${alerts.length ? `<ul class="alerts">${alerts.map(a => `<li>${a}</li>`).join('')}</ul>` : '<p class="note">Nothing to flag for this month.</p>'}</div>
  </div>`;
}
function wireDashboard(v){
  const nav = dir => { const m = (!state.month || state.month === 'all') ? THIS_MONTH : state.month;
    const ds = [...new Set(state.lines.filter(l => !l.excluded && l.month === m).map(l => l.date).filter(Boolean))].sort();
    const curDay = (state.day && ds.includes(state.day)) ? state.day : (ds.filter(d => d <= TODAY).pop() || ds[ds.length-1]);
    const j = ds.indexOf(curDay) + dir; if (j >= 0 && j < ds.length){ state.day = ds[j]; render(); } };
  const pv = v.querySelector('#pdPrev'), nx = v.querySelector('#pdNext');
  if (pv) pv.onclick = () => nav(-1); if (nx) nx.onclick = () => nav(1);
  const f = v.querySelector('#tform'); if (!f) return;
  f.onsubmit = e => { e.preventDefault(); const m = (!state.month || state.month === 'all') ? THIS_MONTH : state.month; const t = {};
    for (const [gg] of GROUPS){ const n = Number(v.querySelector('#t_' + gg).value); if (n > 0) t[gg] = n; }
    saveTargets(m, t); };
}

// ================= Language: 한국어 / English =================
// The page is written in English. In Korean mode every text the page shows is translated after it is drawn.
// Product names, channel names, customer names and file names are never translated (they are not in these lists).
const LANG = { cur: local.get('lang', (navigator.language || '').toLowerCase().startsWith('ko') ? 'ko' : 'en') };
const isKo = () => LANG.cur === 'ko';
const GKO = { Retail: '리테일', Parcel: '택배', Other: '기타' };
