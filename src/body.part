// Texts with numbers or names inside: [pattern, Korean]. Names captured by ( ) are kept as they are.
const KO_RE = [
  [/^(\d[\d,]*) units · (\d[\d,]*) lines(?: ·)?$/, (m, a, b) => `${a}개 · ${b}줄${m.endsWith('·') ? ' ·' : ''}`],
  [/^(\d[\d,]*) unpriced$/, '가격 없음 $1'],
  [/^(\d+) with notes$/, '메모 $1'],
  [/^(\d+) other sheets? not used \(pivots, print or template sheets\)$/, '사용하지 않은 시트 $1개 (피벗·출력용·서식)'],
  [/^(\d+) old sheets? skipped \(dated outside the last year, or an old outbound list\): (.*)$/, '오래된 시트 $1개 건너뜀 (1년 이전 날짜 또는 예전 출고 목록): $2'],
  [/^(.*): (\d+) old sheets? skipped \(dated outside the last year, or an old outbound list\): (.*)$/, '$1: 오래된 시트 $2개 건너뜀 (1년 이전 날짜 또는 예전 출고 목록): $3'],
  [/^(\d+) duplicate lines? left out$/, '중복 $1줄 제외'],
  [/^(\d+) duplicate lines? (?:was|were) found and counted once\.$/, '중복 $1줄을 찾아 한 번만 계산했습니다.'],
  [/^(\d+) free-gift lines valued at cost$/, '사은품 $1줄을 원가로 계산'],
  [/^(\d+) 택배 lines with no channel$/, '채널을 알 수 없는 택배 $1줄'],
  [/^([\d,]+) 택배 lines got their channel from the order-number format$/, '택배 $1줄은 주문번호 형식으로 채널을 판단했습니다'],
  [/^(\d+) lines have no price, so they count as ₩0$/, '가격 없는 $1줄은 ₩0으로 계산됩니다'],
  [/^(\d+) lines have no price$/, '가격 없는 줄 $1개'],
  [/^, so the totals are lower than the real figure\.( Add prices in the Missing prices tab\.)?$/, (m, a) => ', 실제보다 합계가 낮게 나옵니다.' + (a ? ' 가격 없음 탭에서 가격을 입력하세요.' : '')],
  [/^(\d+) Coupang lines from other suppliers left out$/, '다른 공급업체 쿠팡 $1줄 제외'],
  [/^(.*) – tick "Include non-Wellwell Coupang suppliers" to count them$/, '$1 – "웰웰 외 쿠팡 공급업체 포함"을 체크하면 포함됩니다'],
  [/^for (\d+) weekdays?: (.*)\. Totals for those days may be missing\.$/, '(평일 $1일): $2. 해당 날짜 합계가 빠졌을 수 있습니다.'],
  [/^(\d+) products · factory price incl\. VAT$/, '제품 $1개 · 제조원가(부가세 포함)'],
  [/^(\d+) files? added$/, '파일 $1개 추가됨'],
  [/^(\d+) prices imported$/, '가격 $1개를 가져왔습니다'],
  [/^Total · (\d+) products$/, '합계 · 제품 $1개'],
  [/^(.+) · (\d+) products$/, '$1 · 제품 $2개'],
  [/^Products on (.+)$/, '$1 제품'],
  [/^Showing (.+) only$/, '$1만 보기'],
  [/^(.+) overview$/, '$1 개요'],
  [/^(.+) – this month$/, '$1 – 이번 달'],
  [/^Month to date · day (\d+) of (\d+)$/, '이번 달 누계 · $2일 중 $1일째'],
  [/^Month to date: (.+)$/, '이번 달 누계: $1'],
  [/^Last (\d+) months?$/, '최근 $1개월'],
  [/^All files \((\d+)\)$/, '전체 파일 ($1)'],
  [/^(\d+) files? for (.+) · (\d+) in total$/, '$2 파일 $1개 · 전체 $3개'],
  [/^(\d+) files? in total$/, '전체 파일 $1개'],
  [/^Days of (.+) – click a day to see only that day$/, '$1 – 날짜를 누르면 그 날만 봅니다'],
  [/^(\d{4}-\d\d-\d\d): (₩[\d,]+) – click to see this day$/, '$1: $2 – 누르면 이 날만 보기'],
  [/^(\d{4}-\d\d-\d\d): no 택배 file$/, '$1: 택배 파일 없음'],
  [/^(\d{4}-\d\d(?:-\d\d)?) (Retail|Parcel|Other): (.+)$/, (m, a, g, v) => `${a} ${GKO[g]}: ${v}`],
  [/^(\d{4}-\d\d) settlement: (.+)$/, '$1 정산: $2'],
  [/^(\d{4}-\d\d) · settlement (.+)$/, (m, a, b) => `${a} · 정산 ${b.replace('Sokcho', '속초').replace('Uiwang', '의왕')}`],
  [/^Settlement ([\d,]+) – compared at factory price$/, '정산 $1 – 제조원가로 비교'],
  [/^Settlement lines and items not in order files \((.+)\)$/, '정산 항목 및 주문 파일에 없는 항목 ($1)'],
  [/^No files uploaded for (.+) yet\.$/, '$1에 업로드된 파일이 없습니다.'],
  [/^No order files have been uploaded for (.+) yet, so the tally column is empty\.$/, '$1 주문 파일이 아직 없어 집계 열이 비어 있습니다.'],
  [/^No order lines for (.+) yet\. Upload files and they appear here by day\.$/, '$1 주문 내역이 아직 없습니다. 파일을 올리면 날짜별로 여기에 표시됩니다.'],
  [/^No settlement for (.+)\. Settlements loaded: (.+)\.$/, '$1 정산 파일이 없습니다. 업로드된 정산: $2.'],
  [/^Month-end settlement for (\S+) \((Sokcho|Uiwang)\), total ([\d,]+)\. Not added to the tally – used in the Compare tab\.$/, (m, a, s, t) => `${a} 월말 정산 (${s === 'Sokcho' ? '속초' : '의왕'}), 합계 ${t}. 집계에는 더하지 않고 정산 비교 탭에서 사용합니다.`],
  [/^(Admin|Uploader|Viewer) · (.+)$/, (m, r, e) => `${{ Admin: '관리자', Uploader: '업로더', Viewer: '뷰어' }[r]} · ${e}`],
  [/^Signed in as (.+)$/, '로그인: $1'],
  [/^(.*) · uploaded (.+)$/, '$1 · 업로드 $2'],
  [/^uploaded (.+)$/, '업로드 $1'],
  [/^(Data|Latest): (.*)$/, (m, k, rest) => `${k === 'Data' ? '데이터' : '최근'}: ${rest.replace(/ up to (\S+)/g, ' $1까지').replace(' · last upload ', ' · 마지막 업로드 ')}`],
  [/^(.*) ₩([\d,]+) · (.*) ([\d,]+) units$/, '$1 ₩$2 · $3 $4개'],
  [/^(.+) saved under (.+)$/, '$1 → $2에 저장됨'],
  [/^(.+) was already uploaded – skipped$/, '$1 – 이미 업로드된 파일이라 건너뜀'],
  [/^(.+) removed$/, '$1 삭제됨'],
  [/^(.+) added$/, '$1 추가됨'],
  [/^Reading (.+) \((\d+) of (\d+)\)$/, '$1 읽는 중 ($2/$3)'],
  [/^Saving (.+) for the team \((\d+) of (\d+)\)$/, '$1 저장 중 ($2/$3)'],
  [/^Removing (.+)$/, '$1 삭제 중'],
  [/^Moving (.+) to (.+)$/, '$1 → $2로 이동 중'],
  [/^(.*)\(Duplicate of a line in (.+)\)$/, '$1(중복: $2)'],
  [/^Free gift at cost of (.+)$/, '사은품 – $1 원가 적용'],
  [/^Same item as (.+)$/, '같은 제품: $1'],
  [/^Assumed = (.+)$/, '같은 제품으로 가정: $1'],
  [/^July (.+)$/, '7월 $1'],
  [/^Choose (.+) in the Month list to see this file's contents\.$/, '이 파일의 내용을 보려면 월 목록에서 $1을(를) 선택하세요.'],
  [/^(\d+) dup$/, '중복 $1'],
  [/^not counted$/, '집계 제외'],
  [/^Includes B2B \/ 벌크 \/ 오프라인 ([\d,]+)$/, 'B2B·벌크·오프라인 $1 포함'],
  [/^Price for (.+)$/, '$1 가격'], [/^Type for (.+)$/, '$1 유형'], [/^Role for (.+)$/, '$1 역할'], [/^Ship date for (.+)$/, '$1 출고일'],
  [/^Set targets for (.+) \(₩ incl\. VAT\):$/, '$1 목표 설정 (₩, 부가세 포함):'],
  [/^(\d+)% of (.+) (on pace|behind pace)$/, (m, a, b, c) => `${b}의 ${a}% ${c === 'on pace' ? '목표 속도 유지' : '목표보다 느림'}`],
  [/^Could not (.+?): (.*)$/, '처리하지 못했습니다: $2'],
  [/^Shared data problem: (.*)$/, '공유 데이터 문제: $1'],
  [/^Download did not complete \((.*)\)$/, '다운로드가 완료되지 않았습니다 ($1)'],
  [/^(.+): shared storage is full – remove old files first$/, '$1: 저장 공간이 가득 찼습니다 – 오래된 파일을 먼저 삭제하세요'],
  [/^(.+): no order lines found$/, '$1: 주문 내역을 찾지 못했습니다'],
  [/^A reset link was sent to (.+)\.$/, '$1(으)로 재설정 링크를 보냈습니다.'],
  [/^Wellwell – (.+)$/, '웰웰 – $1'],
  [/^Data from (\S+) to (\S+) · created (.+)$/, '데이터 기간 $1 ~ $2 · 작성 $3'],
  [/^Note: (\d+) lines have no price and are counted as 0\.$/, '참고: 가격 없는 $1줄은 0으로 계산했습니다.'],
];
function trText(t){
  if (!isKo() || !t) return t;
  const lead = t.match(/^\s*/)[0], trail = t.match(/\s*$/)[0], core = t.trim();
  if (!core || !/[A-Za-z]/.test(core)) return t;
  if (KO[core] !== undefined) return lead + KO[core] + trail;
  for (const [re, rep] of KO_RE) if (re.test(core)) return lead + core.replace(re, rep) + trail;
  return t;
}
const ORIG = new WeakMap(), ORIG_ATTR = new WeakMap();
const ATTRS = ['placeholder', 'title', 'aria-label'];
function translateNode(root){
  if (!isKo() || !root) return;
  if (root.nodeType === 3){ const p = root.parentElement; if (p && (p.closest('script,style,.no-tr'))) return; const nv = trText(root.nodeValue); if (nv !== root.nodeValue){ if (!ORIG.has(root)) ORIG.set(root, root.nodeValue); root.nodeValue = nv; } return; }
  if (root.nodeType !== 1 || root.closest('script,style,.no-tr')) return;
  const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); const nodes = []; let n; while ((n = w.nextNode())) nodes.push(n);
  nodes.forEach(translateNode);
  const els = [root, ...root.querySelectorAll('[placeholder],[title],[aria-label]')];
  for (const el of els) for (const a of ATTRS){ const v = el.getAttribute && el.getAttribute(a); if (!v) continue; const nv = trText(v); if (nv !== v){ const o = ORIG_ATTR.get(el) || {}; if (!(a in o)) o[a] = v; ORIG_ATTR.set(el, o); el.setAttribute(a, nv); } }
}
const trObserver = new MutationObserver(muts => { if (!isKo()) return; for (const m of muts){ if (m.type === 'characterData') translateNode(m.target); else if (m.type === 'attributes'){ const v = m.target.getAttribute(m.attributeName); const nv = trText(v); if (v && nv !== v){ const o = ORIG_ATTR.get(m.target) || {}; o[m.attributeName] = v; ORIG_ATTR.set(m.target, o); m.target.setAttribute(m.attributeName, nv); } } else m.addedNodes.forEach(translateNode); } });
function restoreEnglish(){
  const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;
  while ((n = w.nextNode())) if (ORIG.has(n)){ n.nodeValue = ORIG.get(n); ORIG.delete(n); }
  document.querySelectorAll('[placeholder],[title],[aria-label]').forEach(el => { const o = ORIG_ATTR.get(el); if (o){ for (const [a, v] of Object.entries(o)) el.setAttribute(a, v); ORIG_ATTR.delete(el); } });
}
function setLang(l){
  LANG.cur = l; local.set('lang', l);
  document.documentElement.lang = l; document.body.classList.toggle('ko', l === 'ko');
  document.querySelectorAll('[data-lang]').forEach(b => { const on = b.dataset.lang === l; b.setAttribute('aria-pressed', on); b.classList.toggle('on', on); });
  if (l === 'en') restoreEnglish();
  recompute();
  if (l === 'ko') translateNode(document.body);
}
document.querySelectorAll('[data-lang]').forEach(b => b.onclick = () => setLang(b.dataset.lang));
trObserver.observe(document.body, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ATTRS });

setLang(LANG.cur);
init();
</script>
